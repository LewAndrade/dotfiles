#!/bin/sh
# Build ~/Applications/OrgProtocol.app and register it as the macOS handler for
# org-protocol:// links, so a browser bookmarklet can send pages to Emacs
# capture, in Doom's small capture frame. Emacs.app only registers mailto:.
# Safe to run again.
set -eu

APP="$HOME/Applications/OrgProtocol.app"
EMACSCLIENT="${EMACSCLIENT:-/opt/homebrew/bin/emacsclient}"
EMACS_APP="${EMACS_APP:-/Applications/Emacs.app}"
PLIST="$APP/Contents/Info.plist"
LSREGISTER=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister

mkdir -p "$HOME/Applications"
rm -rf "$APP"

# The URL is percent-encoded by the bookmarklet, so it holds no double quote or
# backslash and is safe inside an Elisp string. macOS stops an app taking focus
# on its own, so once Emacs has made the capture frame its focused window, this
# applet brings Emacs forward with `open -a', like clicking its Dock icon: no
# Automation permission needed. By path, so a second Emacs is never launched.
osacompile -o "$APP" <<EOF
on open location theURL
	-- In the background: the capture menu waits for a key, and focus must come first.
	do shell script "$EMACSCLIENT -n -e " & quoted form of ("(my/org-protocol-capture-frame \\"" & theURL & "\\")") & " >/dev/null 2>&1 &"
	delay 0.3
	do shell script "/usr/bin/open -a " & quoted form of "$EMACS_APP"
end open location
EOF

/usr/libexec/PlistBuddy -c "Set :CFBundleIdentifier com.lewandrade.org-protocol" "$PLIST" 2>/dev/null \
  || /usr/libexec/PlistBuddy -c "Add :CFBundleIdentifier string com.lewandrade.org-protocol" "$PLIST"
# A background app: no Dock icon while it hands the URL over.
/usr/libexec/PlistBuddy -c "Add :LSUIElement bool true" "$PLIST"
/usr/libexec/PlistBuddy -c "Add :CFBundleURLTypes array" "$PLIST"
/usr/libexec/PlistBuddy -c "Add :CFBundleURLTypes:0 dict" "$PLIST"
/usr/libexec/PlistBuddy -c "Add :CFBundleURLTypes:0:CFBundleURLName string org-protocol" "$PLIST"
/usr/libexec/PlistBuddy -c "Add :CFBundleURLTypes:0:CFBundleURLSchemes array" "$PLIST"
/usr/libexec/PlistBuddy -c "Add :CFBundleURLTypes:0:CFBundleURLSchemes:0 string org-protocol" "$PLIST"

"$LSREGISTER" -f "$APP"
# Other apps claim the scheme too (emacs-plus ships "Emacs Client.app", which
# opens captures in the main frame), so make this one the default handler.
osascript -l JavaScript -e 'ObjC.import("CoreServices"); $.LSSetDefaultHandlerForURLScheme($("org-protocol"), $("com.lewandrade.org-protocol"))' >/dev/null
echo "Registered $APP as the default handler for org-protocol://"
