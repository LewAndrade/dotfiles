(defun my/calendar-restore-test-conflict (&optional missing)
  "Make a saved Org rename conflict with Google deletion; return its marker."
  (let ((marker (my/calendar-test-heading "Original event")))
    (my/org-calendar-auto--start)
    (org-with-point-at marker
      (org-edit-headline "Recovered Org title")
      (goto-char (nth 1 (my/org-calendar-auto--drawer)))
      (insert "\nPrivate local note\n")
      (save-buffer))
    (let* ((event (car (hash-table-values my/calendar-test-server))) (id (plist-get event :id)))
      (if missing (remhash id my/calendar-test-server)
        (puthash id (list :id id :status "cancelled" :etag "deleted-v2") my/calendar-test-server)))
    (my/org-calendar-auto--start)
    marker))

(defun my/calendar-restore-test-choose (marker)
  "Explicitly approve restoration of MARKER's current conflict."
  (let ((record (org-with-point-at marker (my/org-calendar-auto--record))))
    (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t)))
      (my/org-calendar-auto--queue-restore marker (plist-get record :id) (plist-get record :hash)
                                           (plist-get record :conflict)))))

(ert-deftest my/calendar-restore-new-id-preserves-org-data-notes-and-deleted-history ()
  (my/calendar-test-workspace
    (let* ((marker (my/calendar-restore-test-conflict))
           (old-id (org-with-point-at marker (org-entry-get nil "GCAL_AUTO_ID"))))
