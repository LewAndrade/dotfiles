    (my/org-calendar-auto--start)
    (let ((cc (lookup-key org-mode-map (kbd "C-c C-c")))
          (ck (lookup-key org-mode-map (kbd "C-c C-k"))) editor)
      (unwind-protect
          (save-window-excursion
            (with-temp-buffer
              (org-agenda-mode)
              (insert (propertize "Occurrence\n" 'my/org-calendar-repeat-event (gethash "series_0" my/calendar-test-server)))
              (goto-char (point-min))
              (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "This occurrence")))
                (setq editor (my/org-calendar-repeat-edit))))
            (should (equal (lookup-key org-mode-map (kbd "C-c C-c")) cc))
            (should (equal (lookup-key org-mode-map (kbd "C-c C-k")) ck))
            (with-current-buffer editor
              (goto-char (point-min))
              (org-edit-headline "Only this occurrence")
              (call-interactively (lookup-key (current-local-map) (kbd "C-c C-c"))))
            (should (equal (plist-get (plist-get (car my/org-calendar-repeat--pending) :desired) :summary)
                           "Only this occurrence")))
        (when (buffer-live-p editor) (kill-buffer editor))))))

