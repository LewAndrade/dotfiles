        (let* ((id (org-entry-get nil "GCAL_AUTO_ID")) (event (gethash id my/calendar-test-server)))
          (should-not (equal id old-id))
          (should (equal (org-entry-get nil "GCAL_AUTO_RESTORED_FROM") old-id))
          (should (equal (plist-get event :summary) "Recovered Org title"))
