;;; org-calendar-repeat-test.el -*- lexical-binding: t; -*-
(load (expand-file-name "org-calendar-keychain-test.el" (file-name-directory load-file-name)) nil t)

(defun my/calendar-repeat-test-seed (&optional count)
  "Create one indefinite Google series and COUNT expanded test occurrences."
  (let* ((payload (org-with-point-at (my/calendar-test-heading "Series")
                    (prog1 (my/org-calendar-auto--local-payload)
                      (delete-region (point) (point-max)) (save-buffer))))
         (master (my/calendar-test-event payload "series" "master-v1")) events)
    (setq master (plist-put master :recurrence '("RRULE:FREQ=DAILY")))
    (setq master (plist-put master :start (plist-put (plist-get master :start) :timeZone "America/Sao_Paulo")))
    (setq master (plist-put master :end (plist-put (plist-get master :end) :timeZone "America/Sao_Paulo")))
    (puthash "series" master my/calendar-test-server)
    (dotimes (offset (or count 4))
      (let* ((id (format "series_%d" offset))
             (event (my/calendar-test-event payload id "instance-v1")))
        (dolist (key '(:start :end))
          (let ((instant (parse-iso8601-time-string (plist-get (plist-get event key) :dateTime))))
            (setq event (plist-put event key (list :dateTime (format-time-string "%FT%TZ" (time-add instant (days-to-time offset)) t))))))
        (setq event (plist-put event :recurringEventId "series"))
        (setq event (plist-put event :originalStartTime (copy-tree (plist-get event :start))))
        (puthash id event my/calendar-test-server)
        (push event events)))
    (nreverse events)))

(defun my/calendar-repeat-test-headings ()
  (with-current-buffer (my/org-calendar-auto--buffer)
    (org-map-entries (lambda () (org-get-heading t t t t)) nil 'file)))

(defun my/calendar-repeat-test-import (event)
  (let ((marker (my/calendar-test-heading "Old occurrence")))
    (org-with-point-at marker
      (my/org-calendar-auto--import (plist-get event :id) event) (save-buffer))
    marker))

(ert-deftest my/calendar-repeat-one-heading-with-indefinite-rule-and-no-spurious-writes ()
  (my/calendar-test-workspace
    (my/calendar-repeat-test-seed 20)
    (my/org-calendar-auto--start)
    (should (= (length (my/calendar-repeat-test-headings)) 1))
    (should (= (length my/org-calendar-repeat--events) 20))
    (org-with-point-at (my/org-calendar-repeat--series-marker "series")
      (should (equal (org-entry-get nil "recurrence") "[\"RRULE:FREQ=DAILY\"]"))
      (should (equal (my/org-calendar-auto--local-payload)
                     (my/org-calendar-auto--remote-payload (gethash "series" my/calendar-test-server)))))
    (setq my/calendar-test-calls nil)
    (my/org-calendar-auto--start)
    (should (equal my/org-calendar-auto-status "up to date"))
    (should-not (seq-some (lambda (call) (member (car call) '("POST" "PATCH" "DELETE"))) my/calendar-test-calls))))

(ert-deftest my/calendar-repeat-agenda-occurrences-point-to-live-series-marker ()
  (my/calendar-test-workspace
    (my/calendar-repeat-test-seed)
    (my/org-calendar-auto--start)
    (save-window-excursion
      (let ((org-agenda-start-day "2026-10-12") (org-agenda-span 7))
        (org-agenda-list))
      (with-current-buffer org-agenda-buffer-name
        (let ((count 0))
          (goto-char (point-min))
          (while (not (eobp))
            (when-let* ((event (org-get-at-bol 'my/org-calendar-repeat-event)))
              (cl-incf count)
              (let ((marker (org-get-at-bol 'org-hd-marker)))
                (should (buffer-live-p (marker-buffer marker)))
                (org-with-point-at marker (should (equal (org-entry-get nil "GCAL_AUTO_ID") "series"))))
              (should (equal (org-get-at-bol 'my/org-calendar-repeat-id) (plist-get event :id))))
            (forward-line))
          (should (= count 4)))))))

