(ert-deftest my/calendar-repeat-migration-retains-notes-custom-properties-and-conflicts ()
  (my/calendar-test-workspace
    (let ((events (my/calendar-repeat-test-seed)))
      (let ((notes (my/calendar-repeat-test-import (nth 0 events)))
            (custom (my/calendar-repeat-test-import (nth 1 events)))
            (conflict (my/calendar-repeat-test-import (nth 2 events))))
        (my/calendar-repeat-test-import (nth 3 events))
        (org-with-point-at notes
          (goto-char (nth 1 (my/org-calendar-auto--drawer))) (insert "\nPrivate note\n") (save-buffer))
        (org-with-point-at custom (org-entry-put nil "MY_NOTE" "keep me") (save-buffer))
        (org-with-point-at conflict
          (org-edit-headline "Unsent conflict version")
          (my/org-calendar-auto--conflict (plist-put (copy-tree (nth 2 events)) :summary "Other version")) (save-buffer))
        (my/org-calendar-auto--start)
        (should (= (length (my/calendar-repeat-test-headings)) 4))
        (with-current-buffer (my/org-calendar-auto--buffer) (should (string-match-p "Private note" (buffer-string))))
        (org-with-point-at custom (should (equal (org-entry-get nil "MY_NOTE") "keep me")))
        (should (my/org-calendar-repeat--series-marker "series"))
        (should (equal my/org-calendar-auto-status "needs attention"))))))

