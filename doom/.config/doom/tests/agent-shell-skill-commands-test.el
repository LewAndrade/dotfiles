;;; agent-shell-skill-commands-test.el -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'map)
(require 'seq)
(require 'subr-x)

(with-temp-buffer
  (insert-file-contents
   (expand-file-name "../config.org" (file-name-directory load-file-name)))
  (goto-char (point-min))
  (re-search-forward "^(defun my/agent-shell--opencode-skill-request")
  (goto-char (match-beginning 0))
  (eval (read (current-buffer)) t))

(ert-deftest my/opencode-skill-command-uses-normal-prompt-path ()
  (dolist (vectorp '(nil t))
    (let* ((state '((:agent-config . ((:identifier . opencode)))
                    (:available-commands . (((name . "iso-24495") (description . "[skill] Plain language"))))))
           (blocks '(((type . "text") (text . "/iso-24495 Summarize this session"))
                     ((type . "resource_link") (uri . "file:///notes.md"))))
           (request `((:method . "session/prompt")
                      (:params . ((sessionId . "session-test")
                                  (prompt . ,(if vectorp (vconcat blocks) blocks))))))
           sent)
      (my/agent-shell--opencode-skill-request
       (lambda (&rest args) (setq sent (plist-get args :request)))
       :state state :request request)
      (should (equal (map-elt (seq-elt (map-nested-elt sent '(:params prompt)) 0) 'text)
                     "@skill:iso-24495 Summarize this session"))
      (should (equal (map-elt (seq-elt (map-nested-elt request '(:params prompt)) 0) 'text)
                     "/iso-24495 Summarize this session"))
      (should (equal (seq-elt (map-nested-elt sent '(:params prompt)) 1) (nth 1 blocks)))
      (should (equal (map-nested-elt sent '(:params sessionId)) "session-test")))))

(ert-deftest my/opencode-skill-command-leaves-other-requests-unchanged ()
  (dolist (case '((claude-code "session/prompt" "/iso-24495 Summarize")
                  (opencode "session/list" "/iso-24495 Summarize")
                  (opencode "session/prompt" "/review")
                  (opencode "session/prompt" "/iso-24495-other Summarize")
                  (opencode "session/prompt" "Explain /iso-24495")
                  (opencode "session/prompt" "@notes.md")))
    (let* ((state `((:agent-config . ((:identifier . ,(nth 0 case))))
                    (:available-commands . (((name . "iso-24495") (description . "[skill] Plain language"))
                                             ((name . "review") (description . "Review changes"))))))
           (request `((:method . ,(nth 1 case))
                      (:params . ((prompt . [((type . "text") (text . ,(nth 2 case)))])))))
           sent)
      (my/agent-shell--opencode-skill-request
       (lambda (&rest args) (setq sent (plist-get args :request)))
       :state state :request request)
      (should (eq sent request)))))

(ert-deftest my/opencode-skill-command-preserves-empty-and-multiline-arguments ()
  (dolist (text '("/iso-24495" "/iso-24495  " "/iso-24495\nFirst line\nSecond line"))
    (let ((state '((:agent-config . ((:identifier . opencode)))
                   (:available-commands . (((name . "iso-24495") (description . "[skill] Plain language"))))))
          (request `((:method . "session/prompt")
                     (:params . ((prompt . [((type . "text") (text . ,text))])))))
          sent)
      (my/agent-shell--opencode-skill-request
       (lambda (&rest args) (setq sent (plist-get args :request)))
       :state state :request request)
      (should (equal (map-elt (seq-elt (map-nested-elt sent '(:params prompt)) 0) 'text)
                     (concat "@skill:iso-24495" (substring text 10)))))))
