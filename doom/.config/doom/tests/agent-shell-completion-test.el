;;; agent-shell-completion-test.el -*- lexical-binding: t; -*-
;; emacs -Q --batch -l tests/agent-shell-completion-test.el -f ert-run-tests-batch-and-exit
(require 'ert)
(require 'cl-lib)
(require 'map)
(require 'seq)
(require 'subr-x)
(require 'comint)
(setq native-comp-enable-subr-trampolines nil)

(defvar agent-shell--state nil)
(defvar agent-shell-completion--shell-buffer nil)
(defvar my/agent-shell-skill-history nil)
(defconst my/agent-shell-test-config
  (expand-file-name "../config.org" (file-name-directory load-file-name)))

(ert-deftest my/agent-config-tangled-syntax-is-balanced ()
  (let (blocks)
    (with-temp-buffer
      (insert-file-contents my/agent-shell-test-config)
      (goto-char (point-min))
      (while (re-search-forward "^#\\+begin_src emacs-lisp.*\n" nil t)
        (let ((start (point)))
          (re-search-forward "^#\\+end_src")
          (push (buffer-substring-no-properties start (match-beginning 0)) blocks))))
    (with-temp-buffer
      (insert (mapconcat #'identity (nreverse blocks) "\n"))
      (emacs-lisp-mode)
      (check-parens))))

;; Load just our helpers from the literate config, without starting Doom.
(with-temp-buffer
  (insert-file-contents
   (expand-file-name "../config.org" (file-name-directory load-file-name)))
  (goto-char (point-min))
  (re-search-forward "^\\*\\* Skills and file completion")
  (let ((start (point)))
    (re-search-forward "^\\*\\* The package")
    (narrow-to-region start (match-beginning 0))
    (goto-char (point-min))
    (while (re-search-forward "^(def\\(?:un\\|var\\|face\\) " nil t)
      (goto-char (match-beginning 0))
      (eval (read (current-buffer)) t))))

(ert-deftest my/skill-picker-searches-descriptions-and-filters-commands ()
  (with-temp-buffer
    (setq-local agent-shell--state
                '((:available-commands . [((name . "review") (description . "Review"))
                                         ((name . "iso-24495-2")
                                          (description . "[skill] Legal\ncommunication"))
                                         ((name . "iso-24495")
                                          (description . "[skill] General plain language"))])))
    (should (equal (my/agent-shell-skill-candidates (current-buffer))
                   '(("iso-24495-2  Legal communication" . "iso-24495-2")
                     ("iso-24495  General plain language" . "iso-24495"))))))

(ert-deftest my/skill-picker-preview-and-result ()
  (let ((rows '(("report  Report a bug" . "report")
                ("iso-24495-2  Legal communication" . "iso-24495-2")))
        (my/agent-shell-skill-history '("report  Report a bug"))
        preview)
    (cl-letf (((symbol-function 'require) (lambda (&rest _) t))
              ((symbol-function 'consult--read)
               (lambda (table &rest options)
                  (should (string-match-p "Legal" (car table)))
                  (should (plist-get options :require-match))
                  (should (equal table '("iso-24495-2  Legal communication"
                                         "report  Report a bug")))
                  (should (plist-member options :sort))
                  (should-not (plist-get options :sort))
                 (let ((id (funcall (plist-get options :lookup) (car table))))
                   (funcall (plist-get options :state) 'preview id)
                   id)))
              ((symbol-function 'display-buffer)
               (lambda (buffer &rest _)
                 (setq preview buffer)
                 (with-current-buffer buffer
                   (should (equal (buffer-string)
                                  "iso-24495-2\n\nLegal communication"))))))
      (should (equal (my/agent-shell-read-skill rows) "iso-24495-2"))
      (should (equal (cdar rows) "report"))
      (should-not (buffer-live-p preview)))))

(ert-deftest my/skill-picker-columns-align-and-use-theme-faces ()
  (let* ((rows '(("iso-24495-2  Legal communication" . "iso-24495-2")
                 ("report  Report a bug" . "report")))
         (long (my/agent-shell-skill-columns rows 11 (caar rows)))
         (short (my/agent-shell-skill-columns rows 11 (car (cadr rows)))))
    (should (= (string-width (car long)) (string-width (car short))))
    (should (string-prefix-p "  │  " (nth 2 long)))
    (should (eq (get-text-property 0 'face (car long)) 'my/agent-shell-skill-name))
    (should (eq (get-text-property 5 'face (nth 2 long))
                'my/agent-shell-skill-description))))

(ert-deftest my/skill-picker-shortens-display-without-shortening-search-text ()
  (let* ((description (concat (make-string 100 ?a) " searchable-end"))
         (label (concat "report  " description))
         (rows (list (cons label "report"))))
    (cl-letf (((symbol-function 'window-body-width) (lambda (&rest _) 50)))
      (let ((columns (my/agent-shell-skill-columns rows 6 label)))
        (should (<= (+ (string-width (car columns)) (string-width (nth 2 columns))) 50))
        (should (string-suffix-p "…" (nth 2 columns)))
        (should (string-suffix-p "searchable-end" (caar rows)))))))

(ert-deftest my/skill-picker-inserts-at-point-without-sending ()
  (with-temp-buffer
    (setq major-mode 'agent-shell-mode)
    (insert "Prompt> Rewrite this using  please.")
    (goto-char 28)
    (let ((comint-last-prompt (cons (copy-marker 1) (copy-marker 9))))
      (cl-letf (((symbol-function 'require) (lambda (&rest _) t))
                ((symbol-function 'agent-shell-completion--source-buffer) #'current-buffer)
                ((symbol-function 'agent-shell--live-input-prompt-p) (lambda (_) t))
                ((symbol-function 'my/agent-shell-skill-candidates) (lambda (_) '(row)))
                ((symbol-function 'my/agent-shell-read-skill) (lambda (_) "iso-24495-2")))
        (my/agent-shell-insert-skill)
        (should (equal (buffer-string)
                       "Prompt> Rewrite this using the `iso-24495-2` skill  please."))))))

(ert-deftest my/skill-picker-cancel-does-not-edit-prompt ()
  (with-temp-buffer
    (setq major-mode 'agent-shell-viewport-edit-mode)
    (insert "Draft")
    (cl-letf (((symbol-function 'require) (lambda (&rest _) t))
              ((symbol-function 'agent-shell--shell-buffer) (lambda (&rest _) (current-buffer)))
              ((symbol-function 'my/agent-shell-skill-candidates) (lambda (_) '(row)))
              ((symbol-function 'my/agent-shell-read-skill) (lambda (_) (signal 'quit nil))))
      (condition-case nil (my/agent-shell-insert-skill) (quit nil))
      (should (equal (buffer-string) "Draft")))))

(ert-deftest my/skill-picker-refuses-transcript-and-non-agent-buffers ()
  (with-temp-buffer
    (insert "Old output")
    (cl-letf (((symbol-function 'require) (lambda (&rest _) t))
              ((symbol-function 'agent-shell-completion--source-buffer) #'current-buffer))
      (should-error (my/agent-shell-insert-skill) :type 'user-error)
      (setq major-mode 'agent-shell-mode)
      (let ((comint-last-prompt (cons (copy-marker 1) (copy-marker 8))))
        (goto-char 2)
        (cl-letf (((symbol-function 'agent-shell--live-input-prompt-p) (lambda (_) t)))
          (should-error (my/agent-shell-insert-skill) :type 'user-error))))))

(ert-deftest my/file-completion-browses-non-project-files-and-empty-folders ()
  (let* ((directory (make-temp-file "agent-completion-" t))
         (file (expand-file-name "empty.txt" directory))
         (folder (expand-file-name "something" directory))
         (nested (expand-file-name "nested.txt" folder)))
    (unwind-protect
        (progn
          (write-region "" nil file nil 'silent)
          (make-directory folder)
          (with-temp-buffer
            (cl-letf (((symbol-function 'agent-shell-completion--source-buffer) #'current-buffer)
                      ((symbol-function 'agent-shell-cwd) (lambda () directory))
                      ((symbol-function 'project-current) (lambda (&rest _) nil)))
              (let* ((result (my/agent-shell-file-completion
                              (lambda () '(2 2 nil :exclusive no))))
                     (table (nth 2 result)))
                (should (eq (plist-get (nthcdr 3 result) :company-prefix-length) t))
                (should (member "empty.txt" (all-completions "" table)))
                (should (member "something/" (all-completions "" table)))
                (write-region "" nil nested nil 'silent)
                (should (member "nested.txt" (all-completions "something/" table)))
                (should (equal (completion-boundaries "something/" table nil "")
                               '(10 . 0)))))))
      (when (file-exists-p nested) (delete-file nested))
      (delete-file file)
      (delete-directory folder)
      (delete-directory directory))))

(ert-deftest my/file-completion-keeps-project-candidates-and-ignores-non-mentions ()
  (with-temp-buffer
    (cl-letf (((symbol-function 'agent-shell-completion--source-buffer) #'current-buffer)
              ((symbol-function 'agent-shell-cwd) (lambda () default-directory)))
      (let ((result (my/agent-shell-file-completion
                     (lambda () '(2 4 ("src/file.el") :exclusive no)))))
        (should (equal (nth 2 result) '("src/file.el"))))
      (should-not (my/agent-shell-file-completion (lambda () nil))))))

(ert-deftest my/file-completion-only-finalizes-committed-files-not-directories ()
  (with-temp-buffer
    (insert "@My notes.txt")
    (let (finalized)
      (cl-letf (((symbol-function 'agent-shell-completion--source-buffer) #'current-buffer)
                ((symbol-function 'agent-shell-cwd) (lambda () default-directory))
                ((symbol-function 'agent-shell--file-mention)
                 (lambda (path)
                   (push path finalized)
                   (concat "@\"" path "\""))))
        (let* ((result (my/agent-shell-file-completion
                        (lambda () '(2 3 ("file")))))
               (exit (plist-get (nthcdr 3 result) :exit-function)))
          (funcall exit "file" 'exact)
          (funcall exit "file" 'sole)
          (funcall exit "folder/" 'finished)
          (should-not finalized)
          (funcall exit "My notes.txt" 'finished)
          (should (equal finalized '("My notes.txt")))
          (should (equal (buffer-string) "@\"My notes.txt\" ")))))))
