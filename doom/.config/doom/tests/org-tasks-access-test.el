;;; org-tasks-access-test.el --- Separate Tasks authorization and read-only inspection -*- lexical-binding: t; -*-
(require 'ert)
(unless (ert-test-boundp 'my/org-calendar-access-token-never-starts-editor-login)
  (load (expand-file-name "org-workflow-test.el" (file-name-directory load-file-name)) nil t))
(load (expand-file-name "../lisp/org-tasks-access.el" (file-name-directory load-file-name)) nil t)
(defvar my/org-calendar-worker-library-only)
(let ((my/org-calendar-worker-library-only t))
  (load my/org-calendar-auth-worker-file nil t))
(require 'org-gcal)

(defmacro my/tasks-access-test-state (&rest body)
  (declare (indent 0))
  `(let ((my/org-calendar-login-process nil)
         (my/org-calendar-access-token "calendar-token-unchanged")
         (my/org-calendar-token-expiration (+ (float-time) 3600))
         (my/org-calendar-token-passphrase nil)
         (my/org-calendar-auth-problem nil)
          (my/org-tasks-access-token "fake-tasks-token")
          (my/org-tasks-token-account "personal@example.com")
         (my/org-tasks-token-expiration (+ (float-time) 3600))
         (my/org-tasks-access-generation 1)
         (my/org-tasks-access-lists nil)
         (my/org-tasks-access-counts nil)
         (my/org-tasks-access-status "not authorized")
         (my/org-tasks-access-error nil)
          (my/org-tasks-access-error-reasons nil)
          (my/org-tasks-auth-problem nil)
          (my/org-tasks-auth-retry-after 0)
          (my/org-tasks-auth-finished-hook nil)
         (my/org-calendar-approved-primary-id "personal@example.com"))
     ,@body))

(ert-deftest my/tasks-access-provider-and-consent-do-not-replace-calendar ()
  (let ((oauth2-auto-additional-providers-alist '((org-gcal (scope . "calendar-only"))))
        (org-gcal-client-id "fake-client") (org-gcal-client-secret "fake-secret") args)
    (my/org-tasks-worker-provider)
    (should (equal (alist-get 'scope (alist-get 'org-gcal oauth2-auto-additional-providers-alist)) "calendar-only"))
    (should (equal (alist-get 'scope (alist-get 'org-tasks oauth2-auto-additional-providers-alist))
                   "openid email https://www.googleapis.com/auth/tasks"))
    (my/org-tasks-worker-consent (lambda (&rest data) (setq args data)) 'org-tasks 'authorize_url nil '((state . "fake")))
    (should (equal (alist-get 'prompt (nth 3 args)) "consent select_account"))
    (should (equal (alist-get 'include_granted_scopes (nth 3 args)) "true"))
    (my/org-tasks-worker-consent (lambda (&rest data) (setq args data)) 'org-gcal 'authorize_url nil '((state . "fake")))
    (should (equal (nth 3 args) '((state . "fake"))))))

(ert-deftest my/tasks-access-account-must-match-before-any-token-write ()
  (my/tasks-access-test-state
    (let (written checked)
      (cl-letf (((symbol-function 'oauth2-auto--plstore-read) (lambda (&rest _) '(:refresh-token "fake" :expiration 0)))
                ((symbol-function 'oauth2-auto-authenticate) (lambda (&rest _) 'promise))
                ((symbol-function 'aio-wait-for) (lambda (_) '(:access-token "new" :refresh-token "fake")))
                ((symbol-function 'my/org-tasks-worker-check-account)
                 (lambda (account _token) (setq checked account) (error "Wrong account")))
                ((symbol-function 'oauth2-auto--plstore-write) (lambda (&rest _) (setq written t))))
        (should-error (my/org-tasks-worker-token "personal@example.com" nil))
        (should (equal checked "personal@example.com"))
        (should-not written)
        (should-error (my/org-tasks-worker-token "work@example.com" nil))
        (should-not written)))))

(ert-deftest my/tasks-access-userinfo-verifies-email-and-verification-flag ()
  (my/tasks-access-test-state
    (dolist (case '(("personal@example.com" t t) ("work@example.com" t nil) ("personal@example.com" :json-false nil)))
      (let (header)
        (cl-letf (((symbol-function 'url-retrieve-synchronously)
                   (lambda (url &rest _)
                     (should (equal url "https://openidconnect.googleapis.com/v1/userinfo"))
                     (setq header url-request-extra-headers)
                     (let ((buffer (generate-new-buffer " *fake-userinfo*")))
                       (with-current-buffer buffer
                         (setq-local url-http-response-status 200)
                         (insert "HTTP/1.1 200 OK\r\n\r\n" (json-encode `((email . ,(nth 0 case)) (email_verified . ,(nth 1 case))))))
                       buffer))))
          (if (nth 2 case)
              (my/org-tasks-worker-check-account "personal@example.com" '(:access-token "fake"))
            (should-error (my/org-tasks-worker-check-account "personal@example.com" '(:access-token "fake"))))
          (should (equal (cdr (assoc "Authorization" header)) "Bearer fake")))))))

(ert-deftest my/tasks-access-background-never-falls-back-to-browser ()
  (my/tasks-access-test-state
    (let (written)
      (cl-letf (((symbol-function 'oauth2-auto--plstore-read) (lambda (&rest _) nil))
                ((symbol-function 'oauth2-auto-authenticate) (lambda (&rest _) (ert-fail "Background must not authenticate")))
                ((symbol-function 'oauth2-auto--plstore-write) (lambda (&rest _) (setq written t))))
        (should-error (my/org-tasks-worker-token "personal@example.com" t))
        (should-not written)))))

(ert-deftest my/tasks-access-refreshed-token-writes-only-tasks-provider ()
  (my/tasks-access-test-state
    (let (written)
      (cl-letf (((symbol-function 'oauth2-auto--plstore-read) (lambda (&rest _) '(:refresh-token "fake")))
                ((symbol-function 'oauth2-auto-refresh) (lambda (&rest _) 'promise))
                ((symbol-function 'aio-wait-for) (lambda (_) '(:access-token "new" :refresh-token "fake")))
                ((symbol-function 'my/org-tasks-worker-check-account) #'ignore)
                ((symbol-function 'oauth2-auto--plstore-write) (lambda (&rest args) (setq written args))))
        (my/org-tasks-worker-token "personal@example.com" t)
        (should (equal (car written) "personal@example.com"))
        (should (eq (cadr written) 'org-tasks))))))

(ert-deftest my/tasks-access-force-requests-consent-instead-of-reusing-a-partial-grant ()
  (my/tasks-access-test-state
    (let (authorized)
      (cl-letf (((symbol-function 'oauth2-auto--plstore-read)
                 (lambda (&rest _) (list :access-token "partial" :refresh-token "fake" :expiration (+ (float-time) 3600))))
                ((symbol-function 'oauth2-auto-authenticate)
                 (lambda (_account provider) (setq authorized provider) 'promise))
                ((symbol-function 'aio-wait-for) (lambda (_) '(:access-token "new" :refresh-token "fake")))
                ((symbol-function 'my/org-tasks-worker-check-account) #'ignore)
                ((symbol-function 'oauth2-auto--plstore-write) (lambda (_account _provider token) token)))
        (my/org-tasks-worker-token "personal@example.com" nil t)
        (should (eq authorized 'org-tasks))
        (should (equal my/org-calendar-access-token "calendar-token-unchanged"))))))

(ert-deftest my/tasks-access-explicit-setup-retries-a-partial-grant-with-new-consent ()
  (my/tasks-access-test-state
    (let ((my/org-tasks-access-error-reasons '("ACCESS_TOKEN_SCOPE_INSUFFICIENT"))
          (my/org-calendar-token-passphrase (copy-sequence "fake-unlock")) command process)
      (cl-letf (((symbol-function 'my/org-calendar-prepare) #'ignore)
                ((symbol-function 'my/org-tasks-access-show) #'ignore)
                ((symbol-function 'my/org-tasks-access-list) (lambda (&rest _) (ert-fail "Do not reuse a partial grant")))
                ((symbol-function 'process-send-string) #'ignore)
                ((symbol-function 'make-process)
                 (lambda (&rest args)
                   (setq command (plist-get args :command)
                         process (make-pipe-process :name "fake-tasks-reconsent" :buffer nil :noquery t)) process)))
        (unwind-protect
            (progn
              (my/org-tasks-setup)
              (should (member "tasks-reauthorize" command))
              (should (equal my/org-calendar-access-token "calendar-token-unchanged")))
          (when-let* ((timer (and process (process-get process 'timeout-timer)))) (cancel-timer timer))
          (when process (delete-process process)))))))

(ert-deftest my/tasks-access-private-filter-preserves-calendar-token-and-partial-lines ()
  (my/tasks-access-test-state
     (let ((process (make-pipe-process :name "fake-tasks-filter" :buffer nil :noquery t)))
       (process-put process 'tasks-account my/org-calendar-approved-primary-id)
      (unwind-protect
          (let ((output (concat "ORG-CALENDAR TOKEN " (json-encode `((token . "new-tasks-token") (expiration . ,(+ (float-time) 3600)))) "\n")))
            (my/org-tasks-login-filter process (substring output 0 12))
            (should (equal my/org-tasks-access-token "fake-tasks-token"))
            (my/org-tasks-login-filter process (substring output 12))
            (should (equal my/org-tasks-access-token "new-tasks-token"))
            (should (process-get process 'authenticated))
            (should (equal my/org-calendar-access-token "calendar-token-unchanged")))
        (delete-process process)))))

(ert-deftest my/tasks-access-read-only-inspection-paginates-and-counts-phone-completions ()
  (my/tasks-access-test-state
    (let (calls shown)
      (cl-letf (((symbol-function 'my/org-tasks-access-show) (lambda () (setq shown t)))
                ((symbol-function 'my/org-tasks-access-get)
                 (lambda (path params callback)
                   (push (list path params) calls)
                   (cond
                    ((equal path "users/@me/lists")
                     (funcall callback 200 (if (alist-get 'pageToken params)
                                               '(:items ((:id "second" :title "Other")))
                                             '(:items ((:id "first" :title "My Tasks")) :nextPageToken "list-page-2"))))
                    ((equal path "lists/first/tasks")
                     (should (equal (alist-get 'showHidden params) "true"))
                     (funcall callback 200 (if (alist-get 'pageToken params)
                                               '(:items ((:status "completed") (:deleted t)))
                                             '(:items ((:status "needsAction")) :nextPageToken "task-page-2"))))
                    (t (funcall callback 200 '(:items nil)))))))
        (my/org-tasks-access-list)
        (should (= (length calls) 5))
        (should (equal (alist-get "first" my/org-tasks-access-counts nil nil #'equal) '(1 . 1)))
        (should (equal (alist-get "second" my/org-tasks-access-counts nil nil #'equal) '(0 . 0)))
        (should shown)))))

(ert-deftest my/tasks-access-http-is-get-only-and-failure-does-not-touch-calendar ()
  (my/tasks-access-test-state
    (let (args)
      (cl-letf (((symbol-function 'request) (lambda (&rest data) (setq args data)))
                ((symbol-function 'my/org-tasks-access-show) #'ignore))
        (my/org-tasks-access-get "users/@me/lists" nil #'ignore)
        (should (equal (plist-get (cdr args) :type) "GET"))
        (should-not (plist-get (cdr args) :data))
        (my/org-tasks-access-fail 403 '(:error (:errors ((:reason "accessNotConfigured")))))
        (should (string-match-p "Enable Google Tasks API" my/org-tasks-access-error))
        (my/org-tasks-access-fail 403 '(:error (:details ((:reason "SERVICE_DISABLED")))))
        (should (string-match-p "Enable Google Tasks API" my/org-tasks-access-error))
        (my/org-tasks-access-fail 403 '(:error (:details ((:reason "ACCESS_TOKEN_SCOPE_INSUFFICIENT")))))
        (should (string-match-p "permission was not granted" my/org-tasks-access-error))
        (my/org-tasks-access-fail 401 nil)
        (should-not my/org-tasks-access-token)
        (should (equal my/org-calendar-access-token "calendar-token-unchanged"))))))

(ert-deftest my/tasks-access-setup-serializes-store-workers-and-keeps-passphrase-off-args ()
  (my/tasks-access-test-state
    (let ((my/org-tasks-access-token nil) (my/org-calendar-token-passphrase (copy-sequence "fake-unlock"))
          command sent process)
      (cl-letf (((symbol-function 'my/org-calendar-prepare) #'ignore)
                ((symbol-function 'my/org-tasks-access-show) #'ignore)
                ((symbol-function 'make-process)
                 (lambda (&rest args)
                   (setq command (plist-get args :command)
                         process (make-pipe-process :name "fake-tasks-launcher" :buffer nil :noquery t)) process))
                ((symbol-function 'process-send-string) (lambda (_process data) (setq sent data))))
        (unwind-protect
            (progn
              (my/org-tasks-setup)
              (should (member "tasks-login" command))
              (should-not (member "fake-unlock" command))
              (should (equal sent "fake-unlock\n"))
              (should (equal my/org-calendar-token-passphrase "fake-unlock"))
              (should (equal my/org-calendar-access-token "calendar-token-unchanged"))
              (should-error (my/org-tasks-setup) :type 'user-error))
          (when-let* ((timer (and process (process-get process 'timeout-timer)))) (cancel-timer timer))
          (when process (delete-process process)))))))

(ert-deftest my/tasks-access-cancelling-shared-login-calls-the-tasks-sentinel ()
  (my/tasks-access-test-state
    (let ((process (make-pipe-process :name "fake-tasks-cancel" :buffer nil :noquery t)))
      (unwind-protect
          (cl-letf (((symbol-function 'my/org-tasks-access-show) #'ignore))
            (setq my/org-calendar-login-process process)
            (set-process-sentinel process #'my/org-tasks-login-sentinel)
            (my/org-calendar-stop-login)
            (should-not my/org-calendar-login-process)
            (should-not my/org-tasks-access-token)
            (should (equal my/org-calendar-access-token "calendar-token-unchanged"))
            (should-not my/org-calendar-auth-problem))
        (when (process-live-p process) (delete-process process))))))

(ert-deftest my/tasks-access-late-http-replies-from-old-setup-are-ignored ()
  (my/tasks-access-test-state
    (let (callback called)
      (cl-letf (((symbol-function 'request)
                 (lambda (&rest args) (setq callback (plist-get (cdr args) :complete))))
                ((symbol-function 'request-response-status-code) (lambda (_) 200)))
        (my/org-tasks-access-get "users/@me/lists" nil (lambda (&rest _) (setq called t)))
        (cl-incf my/org-tasks-access-generation)
        (funcall callback :response 'fake :data '(:items nil))
        (should-not called)))))

(ert-deftest my/tasks-access-worker-main-dispatches-tasks-and-hides-error-details ()
  (let* ((directory (make-temp-file "tasks-worker-test-" t))
         (settings (expand-file-name "settings.el" directory))
         (store (expand-file-name "tokens.plist" directory))
         (input (expand-file-name "input" directory)))
    (unwind-protect
        (progn
          (write-region "fake-local-unlock\n" nil input nil 'silent)
          (write-region "(setq my/org-calendar-id \"personal@example.com\" my/org-calendar-approved-primary-id my/org-calendar-id)\n"
                        nil settings nil 'silent)
          (dolist (success '(t nil))
            (with-temp-buffer
              (let ((setup
                     `(with-eval-after-load 'org-gcal
                        (defun my/org-calendar-worker-token (&rest _)
                          (error "Never use Calendar token for Tasks"))
                        (defun my/org-tasks-worker-token (account refresh-only)
                          (unless (and (equal account "personal@example.com") (not refresh-only))
                            (error "Wrong role or account"))
                          ,(if success
                               '(list :access-token "fake-tasks-main-token" :expiration (+ (float-time) 3600))
                             '(error "secret-error-payload-must-not-leak"))))))
                (should (= (if success 0 1)
                           (call-process (expand-file-name invocation-name invocation-directory)
                                         input t nil "-Q" "--batch" "--eval"
                                         (prin1-to-string `(setq load-path ',load-path))
                                         "--eval" (prin1-to-string setup)
                                         "-l" my/org-calendar-auth-worker-file "--" settings store "tasks-login")))
                (should-not (string-match-p "secret-error-payload-must-not-leak" (buffer-string)))
                (should (string-match-p (if success "ORG-CALENDAR TOKEN" "ORG-CALENDAR ERROR") (buffer-string)))))))
      (delete-directory directory t))))
