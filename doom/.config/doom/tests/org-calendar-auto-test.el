(ert-deftest my/calendar-auto-newer-local-edits-survive-a-late-write-response ()
  (my/calendar-test-workspace
    (let ((marker (my/calendar-test-heading "Sent title")) reply returned
          (server-request (symbol-function 'my/calendar-test-request)))
      (cl-letf (((symbol-function 'my/org-calendar-auto--request)
                 (lambda (method id payload etag callback &optional params)
                   (if (equal method "POST")
                       (funcall server-request method id payload etag
                                (lambda (status data) (setq reply callback returned (list status data))) params)
                     (funcall server-request method id payload etag callback params)))))
        (my/org-calendar-auto--start)
