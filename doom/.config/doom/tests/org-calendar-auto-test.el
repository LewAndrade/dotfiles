;;; org-calendar-auto-test.el -*- lexical-binding: t; -*-
(load (expand-file-name "org-workflow-test.el" (file-name-directory load-file-name)) nil t)
(require 'org-gcal)
(load (expand-file-name "../lisp/org-calendar-auto.el" (file-name-directory load-file-name)) nil t)

(defvar my/calendar-test-server nil)
(defvar my/calendar-test-calls nil)
(defvar my/calendar-test-lost-reply nil)

(defun my/calendar-test-event (payload id etag)
  (let ((data (json-parse-string (json-encode payload) :object-type 'plist :array-type 'list)))
    (append (list :id id :etag etag) data)))

(defun my/calendar-test-request (method id payload etag callback &optional _params)
  (push (list method id payload etag) my/calendar-test-calls)
  (let ((existing (and id (gethash id my/calendar-test-server))))
    (cond
     ((and (equal method "GET") (null id))
      (funcall callback 200 (list :items (hash-table-values my/calendar-test-server))))
     ((equal method "GET") (funcall callback (if existing 200 404) existing))
     ((equal method "POST")
      (let* ((new-id (alist-get 'id payload))
             (event (my/calendar-test-event payload new-id "v1")))
        (puthash new-id event my/calendar-test-server)
        (if my/calendar-test-lost-reply
            (progn (setq my/calendar-test-lost-reply nil) (funcall callback nil nil))
          (funcall callback 200 event))))
     ((not (equal etag (plist-get existing :etag))) (funcall callback 412 nil))
     ((equal method "PATCH")
      (let ((event (my/calendar-test-event payload id "v2")))
        (dolist (key '(:recurringEventId :originalStartTime))
          (when (plist-member existing key)
            (setq event (plist-put event key (plist-get existing key)))))
        (puthash id event my/calendar-test-server)
        (funcall callback 200 event)))
     ((equal method "DELETE")
       (puthash id (append (list :id id :etag "deleted" :status "cancelled")
                           (when (plist-get existing :recurringEventId)
                             (list :recurringEventId (plist-get existing :recurringEventId)
                                   :originalStartTime (plist-get existing :originalStartTime)))) my/calendar-test-server)
      (funcall callback 204 nil))
     (t (ert-fail "Unexpected API operation")))))

(defmacro my/calendar-test-workspace (&rest body)
  (declare (indent 0))
  `(my/org-test-workspace
     (let* ((my/org-gcal-test-calendar-id "test@group.calendar.google.com")
            (my/org-calendar-auto--calendar my/org-gcal-test-calendar-id)
            (my/org-calendar-auto--file (my/org-file "calendar-personal.org"))
            (my/org-calendar-auto-mode t)
            (my/org-calendar-auto--busy nil)
            (my/org-calendar-auto--rerun nil)
            (my/org-calendar-auto--saving nil)
            (my/org-calendar-auto--attention nil)
            (my/org-calendar-auto--generation 1)
            (my/org-calendar-auto-status "pending")
            (my/org-calendar-settings-file (expand-file-name "settings.el" org-directory))
            (my/org-calendar-repeat--context nil)
            (my/org-calendar-repeat--events nil)
            (my/org-calendar-repeat--pending nil)
            (my/org-calendar-repeat--last-backup nil)
            (org-gcal--sync-lock nil)
            (my/calendar-test-server (make-hash-table :test 'equal))
            (my/calendar-test-calls nil)
            (my/calendar-test-lost-reply nil))
       (cl-letf (((symbol-function 'my/org-calendar-auto--request) #'my/calendar-test-request)
                 ((symbol-function 'my/org-calendar-auto--refresh-agendas) #'ignore)
                 ((symbol-function 'my/org-calendar-auto--schedule) #'ignore)
                 ((symbol-function 'run-at-time)
                  (lambda (_time _repeat function &rest args) (apply function args))))
         ,@body))))

(defun my/calendar-test-heading (text)
  (with-current-buffer (find-file-noselect my/org-calendar-auto--file)
    (goto-char (point-max))
    (insert "\n* " text "\n:org-gcal:\n<2026-10-12 Mon 10:00>--<2026-10-12 Mon 11:00>\n:END:\n")
    (org-back-to-heading t)
    (let ((marker (point-marker))) (save-buffer) marker)))

(ert-deftest my/calendar-auto-create-is-idempotent-after-lost-reply ()
  (my/calendar-test-workspace
    (let ((marker (my/calendar-test-heading "Create automatically")))
      (setq my/calendar-test-lost-reply t)
      (my/org-calendar-auto--start)
      (should (equal my/org-calendar-auto-status "pending"))
      (my/org-calendar-auto--start)
      (should (= (hash-table-count my/calendar-test-server) 1))
      (should (= (cl-count "POST" my/calendar-test-calls :key #'car :test #'equal) 1))
      (org-with-point-at marker
        (should (org-entry-get nil "entry-id"))
        (should (org-entry-get nil "GCAL_AUTO_BASE")))
      (should (equal my/org-calendar-auto-status "up to date")))))

(ert-deftest my/calendar-auto-local-edit-and-cancel ()
  (my/calendar-test-workspace
    (let ((marker (my/calendar-test-heading "Initial title")))
      (my/org-calendar-auto--start)
      (org-with-point-at marker (org-edit-headline "Updated title") (save-buffer))
      (my/org-calendar-auto--start)
      (should (equal (plist-get (car (hash-table-values my/calendar-test-server)) :summary) "Updated title"))
      (org-with-point-at marker (org-todo "CANCELLED") (save-buffer))
