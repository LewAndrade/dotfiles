                             (my/org-calendar-auto--hash (my/org-calendar-auto--local-payload)))))
        (should (equal my/org-calendar-auto-status "pending")))
      (my/org-calendar-auto--start)
      (should (equal (plist-get (car (hash-table-values my/calendar-test-server)) :summary) "Newer title")))))

