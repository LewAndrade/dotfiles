      (my/org-calendar-auto--start)
      (org-with-point-at marker (org-edit-headline "Org choice") (save-buffer))
      (let* ((event (car (hash-table-values my/calendar-test-server))) (id (plist-get event :id)))
        (puthash id (plist-put (plist-put (copy-tree event) :summary "Google choice") :etag "google-v2") my/calendar-test-server)
        (my/org-calendar-auto--start)
        (org-with-point-at marker
          (should (equal (org-get-heading t t t t) "Org choice"))
          (should (equal (plist-get (my/org-calendar-auto--decode (org-entry-get nil "GCAL_AUTO_CONFLICT")) :summary)
                         "Google choice")))
