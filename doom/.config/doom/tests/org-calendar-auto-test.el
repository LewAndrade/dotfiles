      (should (equal (plist-get (car (hash-table-values my/calendar-test-server)) :status) "cancelled"))
      (should (equal (nth 3 (car my/calendar-test-calls)) "v2"))
      (org-with-point-at marker (should (equal (org-get-todo-state) "CANCELLED"))))))

