(ert-deftest my/calendar-auto-all-day-ends-are-exclusive-and-dst-safe ()
  (my/calendar-test-workspace
    (let ((marker (my/calendar-test-heading "All day")))
      (org-with-point-at marker
        (let ((drawer (my/org-calendar-auto--drawer)))
          (goto-char (car drawer))
          (delete-region (nth 0 drawer) (nth 1 drawer))
          (insert ":org-gcal:\n<2026-10-12 Mon>--<2026-10-14 Wed>\n:END:\n")
          (org-back-to-heading t))
        (let ((payload (my/org-calendar-auto--local-payload)))
          (should (equal (alist-get 'date (alist-get 'start payload)) "2026-10-12"))
          (should (equal (alist-get 'date (alist-get 'end payload)) "2026-10-15"))))
      (should (equal (my/org-calendar-auto--timestamp '(:start (:date "2026-10-12") :end (:date "2026-10-15")))
                     "<2026-10-12>--<2026-10-14>"))
      (should (equal (my/org-calendar-auto--day 2026 12 31 1) "2027-01-01")))))

(ert-deftest my/calendar-auto-all-day-capture-produces-date-only-google-event ()
  (my/calendar-test-workspace
    (let ((dates (list (encode-time 0 0 0 12 10 2026) (encode-time 0 0 0 12 10 2026))))
      (cl-letf (((symbol-function 'org-read-date) (lambda (&rest _) (pop dates))))
        (save-window-excursion
          (org-capture nil "pa")
          (insert "Captured all-day event")
          (org-capture-finalize))))
    (my/org-calendar-auto--start)
    (let ((event (car (hash-table-values my/calendar-test-server))))
      (should (equal (plist-get event :summary) "Captured all-day event"))
      (should (equal (plist-get (plist-get event :start) :date) "2026-10-12"))
      (should (equal (plist-get (plist-get event :end) :date) "2026-10-13"))
       (should-not (plist-get (plist-get event :start) :dateTime)))))

(ert-deftest my/calendar-auto-duration-capture-saved-before-finalizing-syncs-once ()
  (my/calendar-test-workspace
    (let ((start (encode-time 0 30 23 31 12 2026)) (duration-calls 0))
      (cl-letf (((symbol-function 'org-read-date) (lambda (&rest _) start))
                ((symbol-function 'read-string)
                 (lambda (&rest _)
                   (should (= (cl-incf duration-calls) 1)) "1h30m")))
        (save-window-excursion
          (org-capture nil "pe")
          (insert "Overnight duration capture")
          (save-buffer)
          (org-capture-finalize)))
      (my/org-calendar-auto--start)
      (my/org-calendar-auto--start)
      (let ((event (car (hash-table-values my/calendar-test-server))))
        (should (equal (plist-get event :summary) "Overnight duration capture"))
        (should (equal (plist-get (plist-get event :start) :dateTime)
                       (format-time-string "%FT%TZ" start t)))
        (should (equal (plist-get (plist-get event :end) :dateTime)
                       (format-time-string "%FT%TZ" (time-add start (seconds-to-time 5400)) t))))
      (should (= (hash-table-count my/calendar-test-server) 1))
      (should (= (cl-count "POST" my/calendar-test-calls :key #'car :test #'equal) 1)))))

