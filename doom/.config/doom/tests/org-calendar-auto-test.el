(ert-deftest my/calendar-auto-http-adapter-is-async-and-uses-if-match ()
  (my/calendar-test-workspace
    (let (url options completed)
      (cl-letf (((symbol-function 'request)
                 (lambda (endpoint &rest args) (setq url endpoint options args)))
                ((symbol-function 'request-response-status-code) (lambda (_) 200)))
        ;; Bypass the fake server for this adapter test.
        (let ((adapter (with-temp-buffer
                         (insert-file-contents (expand-file-name "../lisp/org-calendar-auto.el"
                                                                (file-name-directory my/org-calendar-test-worker-file)))
                         (goto-char (point-min)) (search-forward "(defun my/org-calendar-auto--request")
                         (goto-char (match-beginning 0)) (read (current-buffer)))))
          (cl-letf (((symbol-function 'my/org-calendar-auto--request) (eval `(lambda ,@(cddr adapter)) t)))
            (my/org-calendar-auto--request "PATCH" "event-id" '((summary . "Title")) "etag-v1"
                                           (lambda (&rest _) (setq completed t)))))
        (should (string-match-p "/calendars/test%40group.calendar.google.com/events/event-id" url))
        (should-not (plist-get options :sync))
        (should (= (plist-get options :timeout) 20))
        (should (equal (cdr (assoc "If-Match" (plist-get options :headers))) "etag-v1"))
        (cl-incf my/org-calendar-auto--generation)
        (funcall (plist-get options :complete) :response 'fake :data '(:id "event-id"))
        (should-not completed)))))
