(ert-deftest my/calendar-auto-package-capture-hook-cannot-bypass-the-sync-queue ()
  (my/calendar-test-workspace
    (let ((org-capture-after-finalize-hook (list 'org-gcal--capture-post))
          (org-after-refile-insert-hook (list 'org-gcal--refile-post))
          (org-gcal-fetch-file-alist (list (cons my/org-calendar-auto--calendar my/org-calendar-auto--file)))
          (dates (list (encode-time 0 0 0 12 10 2026) (encode-time 0 0 0 12 10 2026)))
          (org/calendar-test-published nil))
      (cl-letf (((symbol-function 'org-read-date) (lambda (&rest _) (pop dates)))
                ((symbol-function 'org-gcal-post-at-point)
                 (lambda (&rest _) (setq org/calendar-test-published t))))
        (my/org-calendar-disable-package-auto-post)
        (should-not (memq 'org-gcal--capture-post org-capture-after-finalize-hook))
        ;; Simulate the package lazily registering its hook again after setup.
        (add-hook 'org-capture-after-finalize-hook 'org-gcal--capture-post)
        (save-window-excursion
          (org-capture nil "pa")
          (insert "One owner of publishing")
          (org-capture-finalize))
        (should-not org/calendar-test-published)
        (with-current-buffer (find-file-noselect my/org-calendar-auto--file)
          (should-not (buffer-modified-p)))
        (my/org-calendar-auto--start)
        (should (= (cl-count "POST" my/calendar-test-calls :key #'car :test #'equal) 1))))))

