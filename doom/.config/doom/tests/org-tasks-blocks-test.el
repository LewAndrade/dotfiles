;;; org-tasks-blocks-test.el --- Local-only task/time-block presentation -*- lexical-binding: t; -*-
(require 'ert)
(unless (ert-test-boundp 'my/calendar-view-shows-scheduled-tasks-and-deadlines-without-making-appointments)
  (load (expand-file-name "org-calendar-repeat-test.el" (file-name-directory load-file-name)) nil t))
(unless (ert-test-boundp 'my/tasks-sync-publishes-all-personal-tasks-not-notes-work-or-planning-details)
  (load (expand-file-name "org-tasks-sync-test.el" (file-name-directory load-file-name)) nil t))
(load (expand-file-name "../lisp/org-tasks-blocks.el" (file-name-directory load-file-name)) nil t)

(defmacro my/tasks-block-test-workspace (&rest body)
  (declare (indent 0))
  `(my/tasks-test-workspace
     (let ((my/org-calendar-auto--calendar my/org-tasks-account)
           (my/org-calendar-id my/org-tasks-account)
           (my/org-calendar-auto--file (my/org-file "calendar-personal.org"))
           (my/org-calendar-settings-file (expand-file-name "private/calendar.el" org-directory))
           (my/org-calendar-repeat--context nil) (my/org-calendar-repeat--events nil)
           (my/org-calendar-repeat--pending nil)
           (my/org-calendar-auto--remote-table (make-hash-table :test 'equal))
           (my/org-calendar-auto--busy nil) (my/org-calendar-auto--refreshing nil)
           (my/org-tasks-block--rendering nil) (my/org-tasks-block--problem nil)
           (org-agenda-start-day "2026-10-13") (org-agenda-span 1)
           (old-zone (getenv "TZ")))
       (write-region "#+category: Personal\n" nil my/org-calendar-auto--file nil 'silent)
       (write-region "#+category: Work\n" nil (my/org-file "calendar-work.org") nil 'silent)
       (unwind-protect
           (progn (set-time-zone-rule "UTC") (my/org-configure-workflow)
                  (setq org-agenda-start-day "2026-10-13")
                  (my/org-tasks-block-mode 1)
                  (cl-letf (((symbol-function 'org-today)
                             (lambda () (calendar-absolute-from-gregorian '(10 13 2026))))) ,@body))
         (my/org-tasks-block-mode -1)
         (set-time-zone-rule old-zone)
         (when (get-buffer "*Personal Tasks Sync*") (kill-buffer "*Personal Tasks Sync*"))))))

(defun my/tasks-block-test-seed (&optional title)
  (my/tasks-test-add (format "** TODO %s\nSCHEDULED: <2026-10-13 Tue>\nPrivate task note\n" (or title "Shared task")))
  (my/org-tasks--start)
  (let* ((key (plist-get (my/tasks-test-record) :key))
         (event (list :id "block-1" :eventType "focusTime" :status "confirmed" :etag "block-etag"
                      :summary (or title "Shared task") :start '(:dateTime "2026-10-13T19:00:00Z")
                      :end '(:dateTime "2026-10-13T20:00:00Z"))))
    (puthash "block-1" event my/org-calendar-auto--remote-table)
    (with-current-buffer (find-file-noselect my/org-calendar-auto--file)
      (goto-char (point-max)) (insert "* Placeholder\n") (forward-line -1)
      (my/org-calendar-auto--import "block-1" event)
      (org-end-of-subtree t t) (insert "Private block note\n") (save-buffer))
    key))

(defun my/tasks-block-test-day-lines (&optional date)
  (let (lines)
    (dolist (name '("personal.org" "calendar-personal.org"))
      (setq lines (append lines (org-agenda-get-day-entries (my/org-file name) (or date '(10 13 2026))
                                                           :timestamp :scheduled :deadline))))
    lines))

(defun my/tasks-block-test-ordinary-lines (lines)
  (seq-filter (lambda (line) (get-text-property 0 'org-hd-marker line)) lines))

(ert-deftest my/tasks-block-no-title-based-auto-merging-or-focus-time-hiding ()
  (my/tasks-block-test-workspace
    (my/tasks-block-test-seed)
    (let ((lines (my/tasks-block-test-ordinary-lines (my/tasks-block-test-day-lines))))
      (should (= (length lines) 2))
      (should-not (seq-some (lambda (line) (get-text-property 0 'my/org-task-block line)) lines)))
    (should-not (file-exists-p (my/org-tasks-block--file)))))

(ert-deftest my/tasks-block-one-timed-task-row-with-real-source-markers ()
  (my/tasks-block-test-workspace
    (let ((key (my/tasks-block-test-seed)))
      (my/org-tasks-block--link key "block-1")
      (let* ((lines (my/tasks-block-test-ordinary-lines (my/tasks-block-test-day-lines))) (line (car lines)))
        (should (= (length lines) 1))
        (should (equal (get-text-property 0 'time line) "19:00-20:00"))
        (should (string-match-p "TODO.*Shared task" line))
        (should (get-text-property 0 'my/org-task-block line))
        (should (equal (get-text-property 0 'org-hd-marker line) (my/org-tasks--marker key)))
        (let ((stamp-marker (get-text-property 0 'org-marker line)))
          (should (equal (marker-buffer stamp-marker) (marker-buffer (my/org-tasks--marker key))))
          (org-with-point-at stamp-marker (should (org-at-timestamp-p (quote lax)))))
        (should (member (get-text-property 0 'type line) '("scheduled" "past-scheduled")))))))

(ert-deftest my/tasks-block-confirmation-and-rendering-never-save-sources-or-call-google ()
  (my/tasks-block-test-workspace
    (let* ((key (my/tasks-block-test-seed))
           (buffers (mapcar #'find-file-noselect (list my/org-tasks--file my/org-calendar-auto--file)))
           (snapshots (mapcar (lambda (buffer) (with-current-buffer buffer
                                                (list (buffer-string) (buffer-chars-modified-tick) (point)))) buffers)))
      (cl-letf (((symbol-function 'save-buffer) (lambda (&rest _) (ert-fail "Do not save source files")))
                ((symbol-function 'request) (lambda (&rest _) (ert-fail "Do not contact Google"))))
        (my/org-tasks-block--link key "block-1")
        (my/tasks-block-test-day-lines)
        (apply #'my/org-calendar-view--list (my/calendar-view-test-range)))
      (cl-mapc (lambda (buffer snapshot) (with-current-buffer buffer
                                          (should (equal (buffer-string) (nth 0 snapshot)))
                                          (should (= (buffer-chars-modified-tick) (nth 1 snapshot)))
                                          (should (= (point) (nth 2 snapshot)))
                                          (should-not (buffer-modified-p)))) buffers snapshots)
      (should (= #o600 (logand (file-modes (my/org-tasks-block--file)) #o777)))
      (should (equal (plist-get (car (my/org-tasks-block--read)) :key) key)))))

(ert-deftest my/tasks-block-done-and-cancelled-do-not-leave-an-unfinished-calendar-row ()
  (my/tasks-block-test-workspace
    (let ((key (my/tasks-block-test-seed)))
      (my/org-tasks-block--link key "block-1")
      (dolist (state '("DONE" "CANCELLED"))
        (my/tasks-test-edit (lambda () (let ((org-inhibit-logging t)) (org-todo state))))
        (should-not (my/tasks-block-test-ordinary-lines (my/tasks-block-test-day-lines)))
        (should-not (apply #'my/org-calendar-view--list (my/calendar-view-test-range))))
      (with-current-buffer (find-file-noselect my/org-calendar-auto--file)
        (goto-char (point-min)) (re-search-forward org-heading-regexp) (org-back-to-heading t)
        (should-not (org-get-todo-state))
        (should (string-match-p "Private block note" (buffer-string)))))))

(ert-deftest my/tasks-block-review-deduplicates-the-canonical-task-not-a-same-title-neighbour ()
  (my/tasks-block-test-workspace
    (let ((key (my/tasks-block-test-seed)))
      (my/org-tasks-block--link key "block-1")
      (my/tasks-test-add "** TODO Shared task\nUnrelated undated task\n")
      (save-window-excursion
        (org-agenda nil "r")
        (with-current-buffer org-agenda-buffer-name
          (let ((count 0) (paired 0))
            (goto-char (point-min))
            (while (not (eobp))
              (when (string-match-p "Shared task" (buffer-substring-no-properties (line-beginning-position) (line-end-position)))
                (cl-incf count)
                (when (org-get-at-bol 'my/org-task-block) (cl-incf paired)))
              (forward-line))
            (should (= count 2)) (should (= paired 1))
            (should (string-match-p "Other open tasks" (buffer-string)))))))))

(ert-deftest my/tasks-block-timegrid-shows-one-timed-task-and-ret-visits-the-task ()
  (my/tasks-block-test-workspace
    (let ((key (my/tasks-block-test-seed)))
      (my/org-tasks-block--link key "block-1")
      (my/tasks-test-add "** TODO Local timed task\nSCHEDULED: <2026-10-13 Tue 21:00>\n** TODO Date-only task\nSCHEDULED: <2026-10-13 Tue>\n")
      (let* ((events (apply #'my/org-calendar-view--list (my/calendar-view-test-range)))
             (paired (seq-find (lambda (event) (equal (org-timegrid-event-title event) "TODO Shared task")) events)))
        (should (= (length events) 3))
        (should-not (org-timegrid-event-all-day paired))
        (should (= (- (org-timegrid-event-end paired) (org-timegrid-event-start paired)) 60))
        (should (= (mod (org-timegrid-event-start paired) 1440) (* 19 60)))
        (should (equal (plist-get (org-timegrid-event-source paired) :heading-marker) (my/org-tasks--marker key)))
        (should-not (plist-get (org-timegrid-event-source paired) :marker))))))

(ert-deftest my/tasks-block-native-state-action-keeps-projection-and-edits-only-the-task ()
  (my/tasks-block-test-workspace
    (let ((key (my/tasks-block-test-seed)))
      (my/org-tasks-block--link key "block-1")
      (save-window-excursion
        (org-agenda nil "r")
        (with-current-buffer org-agenda-buffer-name
          (goto-char (point-min))
          (while (and (not (eobp)) (not (org-get-at-bol 'my/org-task-block))) (forward-line))
          (let ((org-inhibit-logging t)) (org-agenda-todo "DOING"))
          (should (string-match-p "19:00-20:00.*DOING.*Shared task" (buffer-string)))
          (should (equal (org-get-at-bol 'org-hd-marker) (my/org-tasks--marker key))))
        (org-with-point-at (my/org-tasks--marker key) (should (equal (org-get-todo-state) "DOING")))))))

(ert-deftest my/tasks-block-own-local-time-or-repeater-stays-local-and-disables-projection ()
  (my/tasks-block-test-workspace
    (let ((key (my/tasks-block-test-seed)))
      (my/org-tasks-block--link key "block-1")
      (dolist (stamp '("<2026-10-13 Tue 21:00>" "<2026-10-13 Tue +1w>"))
        (my/tasks-test-edit (lambda () (org-entry-put nil "SCHEDULED" stamp)))
        (should (plist-get (car (my/org-tasks-block--pairs)) :reason))
        (should (= (length (my/tasks-block-test-ordinary-lines (my/tasks-block-test-day-lines))) 2))
        (should-not (seq-some (lambda (line) (get-text-property 0 'my/org-task-block line)) (my/tasks-block-test-day-lines)))))))

(ert-deftest my/tasks-block-renaming-either-side-retains-confirmed-identities ()
  (my/tasks-block-test-workspace
    (let ((key (my/tasks-block-test-seed)))
      (my/org-tasks-block--link key "block-1")
      (my/tasks-test-edit (lambda () (org-edit-headline "Different task title")))
      (let* ((block (car (my/org-tasks-block--sources 'block)))
             (remote (copy-tree (gethash "block-1" my/org-calendar-auto--remote-table))))
        (setq remote (plist-put remote :summary "Different block title"))
        (puthash "block-1" remote my/org-calendar-auto--remote-table)
        (org-with-point-at (plist-get block :marker) (my/org-calendar-auto--import "block-1" remote) (save-buffer)))
      (let ((lines (my/tasks-block-test-ordinary-lines (my/tasks-block-test-day-lines))))
        (should (= (length lines) 1)) (should (string-match-p "Different task title" (car lines)))))))

(ert-deftest my/tasks-block-requires-an-exact-confirmed-focus-time-event-and-no-unsaved-edits ()
  (my/tasks-block-test-workspace
    (let ((key (my/tasks-block-test-seed)) (remote (gethash "block-1" my/org-calendar-auto--remote-table)))
      (puthash "block-1" (plist-put (copy-tree remote) :eventType "default") my/org-calendar-auto--remote-table)
      (should-error (my/org-tasks-block--link key "block-1") :type 'user-error)
      (puthash "block-1" remote my/org-calendar-auto--remote-table)
      (with-current-buffer (my/org-tasks--buffer) (goto-char (point-max)) (insert "Unsaved note\n"))
      (should-error (my/org-tasks-block--link key "block-1") :type 'user-error)
      (should-not (file-exists-p (my/org-tasks-block--file))))))

