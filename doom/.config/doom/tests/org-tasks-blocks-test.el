(ert-deftest my/tasks-block-block-conflict-overnight-or-recurrence-keeps-both-sources ()
  (my/tasks-block-test-workspace
    (let ((key (my/tasks-block-test-seed)))
      (my/org-tasks-block--link key "block-1")
      (let ((block (car (my/org-tasks-block--sources 'block))))
        (org-with-point-at (plist-get block :marker)
          (org-entry-put nil "GCAL_AUTO_CONFLICT" "pending") (save-buffer))
        (should (plist-get (car (my/org-tasks-block--pairs)) :reason))
        (should (= (length (my/tasks-block-test-ordinary-lines (my/tasks-block-test-day-lines))) 2))
        (org-with-point-at (plist-get block :marker) (org-entry-delete nil "GCAL_AUTO_CONFLICT"))
        (let ((remote (copy-tree (gethash "block-1" my/org-calendar-auto--remote-table))))
          (setq remote (plist-put remote :end '(:dateTime "2026-10-14T01:00:00Z")))
          (org-with-point-at (plist-get block :marker) (my/org-calendar-auto--import "block-1" remote) (save-buffer))
          (should (plist-get (car (my/org-tasks-block--pairs)) :reason)))))))

(ert-deftest my/tasks-block-rejected-duplicate-link-and-existing-lock-preserve-private-state ()
  (my/tasks-block-test-workspace
    (let ((key (my/tasks-block-test-seed)))
      (my/org-tasks-block--link key "block-1")
      (should-error (my/org-tasks-block--link key "block-1") :type 'user-error)
      (let* ((file (my/org-tasks-block--file)) (before (with-temp-buffer (insert-file-contents file) (buffer-string)))
             (lock (concat file ".lock")))
        (make-directory lock) (write-region "12345" nil (expand-file-name "pid" lock) nil 'silent)
        (should-error (my/org-tasks-block-unlink key) :type 'user-error)
        (should (file-exists-p (expand-file-name "pid" lock)))
        (should (equal before (with-temp-buffer (insert-file-contents file) (buffer-string))))))))

(ert-deftest my/tasks-block-rendering-preserves-unsaved-private-notes-and-deadline-warnings ()
  (my/tasks-block-test-workspace
    (let ((key (my/tasks-block-test-seed)))
      (my/org-tasks-block--link key "block-1")
