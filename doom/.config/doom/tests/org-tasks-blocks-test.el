(ert-deftest my/tasks-block-corrupt-cross-scope-links-and-changed-account-never-hide-events ()
  (my/tasks-block-test-workspace
    (let ((key (my/tasks-block-test-seed)))
      (my/org-tasks-block--link key "block-1")
      (let ((file (my/org-tasks-block--file)))
        (write-region "not-json" nil file nil 'silent)
