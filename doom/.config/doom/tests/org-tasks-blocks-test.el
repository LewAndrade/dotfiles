(ert-deftest my/tasks-block-native-date-shift-edits-only-the-real-task-date ()
  (my/tasks-block-test-workspace
    (let* ((key (my/tasks-block-test-seed))
           (block-buffer (get-file-buffer my/org-calendar-auto--file))
           (before (with-current-buffer block-buffer (buffer-string))))
      (my/org-tasks-block--link key "block-1")
      (save-window-excursion
        (org-agenda nil "r")
        (with-current-buffer org-agenda-buffer-name
          (goto-char (point-min))
          (while (and (not (eobp)) (not (org-get-at-bol 'my/org-task-block))) (forward-line))
          (org-agenda-date-later 1)
