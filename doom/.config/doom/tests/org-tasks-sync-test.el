    (let ((id (plist-get (my/tasks-test-record) :id)))
      (my/tasks-test-phone id "Renamed on phone") (my/org-tasks--start)
      (org-with-point-at (my/org-tasks--marker (plist-get (my/tasks-test-record) :key)) (should (equal (org-get-todo-state) "WAIT")))
      (my/tasks-test-phone id "Renamed on phone" "completed") (my/org-tasks--start)
      (org-with-point-at (my/org-tasks--marker (plist-get (my/tasks-test-record) :key)) (should (equal (org-get-todo-state) "DONE")))
      (my/tasks-test-phone id "Renamed on phone" "needsAction") (my/org-tasks--start)
      (org-with-point-at (my/org-tasks--marker (plist-get (my/tasks-test-record) :key)) (should (equal (org-get-todo-state) "WAIT")))
      (my/tasks-test-edit (lambda () (let ((org-inhibit-logging t)) (org-todo "DONE")))) (my/org-tasks--start)
      (should (equal (plist-get (my/tasks-test-task) :status) "completed")))))

(ert-deftest my/tasks-sync-phone-rescheduling-keeps-local-time-deadline-and-repeater ()
  (my/tasks-test-workspace
