        (should (equal (org-entry-get nil "SCHEDULED") "<2026-10-15 Thu 09:00-10:30 +1w>"))
        (should (equal (org-entry-get nil "DEADLINE") "<2026-10-20 Tue>")))
      (my/tasks-test-phone id "Timed task") (my/org-tasks--start)
      (org-with-point-at (my/org-tasks--marker (plist-get (my/tasks-test-record) :key))
