;;; org-tasks-sync-test.el --- Disposable two-way checklist regression tests -*- lexical-binding: t; -*-
(require 'ert)
(unless (ert-test-boundp 'my/tasks-access-provider-and-consent-do-not-replace-calendar)
  (load (expand-file-name "org-tasks-access-test.el" (file-name-directory load-file-name)) nil t))
(load (expand-file-name "../lisp/org-tasks-sync.el" (file-name-directory load-file-name)) nil t)
(defvar my/tasks-test-server nil)
(defvar my/tasks-test-calls nil)
(defvar my/tasks-test-counter 0)
(defvar my/tasks-test-drop-post nil)
(defvar my/tasks-test-race nil)
(defvar my/tasks-test-dirty-post nil)
(defvar my/tasks-test-offline nil)
(defvar my/tasks-test-page-size 100)
(defvar my/tasks-test-edit-after-patch nil)
(defconst my/tasks-test-real-request (symbol-function 'my/org-tasks--request))

(defun my/tasks-test-request (method id payload etag callback &optional params)
  (my/org-tasks--check-scope)
  (push (list method id payload etag params) my/tasks-test-calls)
  (if my/tasks-test-offline (funcall callback nil nil)
    (let ((old (and id (gethash id my/tasks-test-server))))
      (when (and (equal method "PATCH") my/tasks-test-race)
        (setq my/tasks-test-race nil)
        (setq old (plist-put old :etag "raced-etag"))
        (puthash id old my/tasks-test-server))
      (cond
       ((and (equal method "GET") (null id))
        (should (equal (alist-get 'showHidden params) "true"))
        (let* ((tasks (sort (hash-table-values my/tasks-test-server)
                            (lambda (a b) (string< (plist-get a :id) (plist-get b :id)))))
               (start (string-to-number (or (alist-get 'pageToken params) "0")))
               (end (min (length tasks) (+ start my/tasks-test-page-size))))
          (funcall callback 200 (append (list :items (cl-subseq tasks start end))
                                        (when (< end (length tasks)) (list :nextPageToken (number-to-string end)))))))
       ((equal method "GET") (funcall callback (if old 200 404) old))
       ((equal method "POST")
        (let* ((new-id (format "task-%d" (cl-incf my/tasks-test-counter)))
               (task (append (list :id new-id :etag (format "etag-%d" my/tasks-test-counter))
                             (json-parse-string (json-encode payload) :object-type 'plist :null-object nil))))
          (should-not (alist-get 'notes payload))
          (puthash new-id task my/tasks-test-server)
          (when my/tasks-test-dirty-post
            (with-current-buffer (my/org-tasks--buffer) (goto-char (point-max)) (insert "Unsaved private addition\n")))
          (if my/tasks-test-drop-post (progn (setq my/tasks-test-drop-post nil) (funcall callback nil nil))
            (funcall callback 200 task))))
       ((not old) (funcall callback 404 nil))
       ((not (equal etag (plist-get old :etag))) (funcall callback 412 old))
       ((equal method "PATCH")
        (let ((task (copy-tree old)))
          (dolist (field payload) (setq task (plist-put task (intern (concat ":" (symbol-name (car field)))) (cdr field))))
          (setq task (plist-put task :etag (format "etag-%d" (cl-incf my/tasks-test-counter))))
          (when my/tasks-test-edit-after-patch
            (my/tasks-test-edit my/tasks-test-edit-after-patch)
            (setq my/tasks-test-edit-after-patch nil))
          (puthash id task my/tasks-test-server) (funcall callback 200 task)))
       ((equal method "DELETE")
        (puthash id (plist-put (copy-tree old) :deleted t) my/tasks-test-server)
        (funcall callback 204 nil))
       (t (ert-fail "Unexpected Tasks method"))))))

(defmacro my/tasks-test-workspace (&rest body)
  (declare (indent 0))
  `(let* ((directory (file-truename (make-temp-file "org-tasks-test-" t)))
          (org-directory directory)
          (org-todo-keywords '((sequence "TODO" "DOING" "WAIT" "|" "DONE" "CANCELLED")))
          (my/org-tasks-list-id "fake-list") (my/org-tasks-account "personal@example.com")
          (my/org-calendar-approved-primary-id my/org-tasks-account)
          (my/org-tasks--list my/org-tasks-list-id) (my/org-tasks--account my/org-tasks-account)
          (my/org-tasks--file (file-truename (expand-file-name "personal.org" directory)))
          (my/org-tasks--scope (my/org-tasks--scope-id))
          (my/org-tasks--state-file (expand-file-name "private/state.json" directory))
          (my/org-tasks--state nil) (my/org-tasks--lock nil) (my/org-tasks-mode t)
          (my/org-tasks--busy nil) (my/org-tasks--rerun nil) (my/org-tasks--error nil)
          (my/org-tasks--locals nil) (my/org-tasks--remote nil) (my/org-tasks--generation 1)
          (my/org-tasks--saving nil) (my/org-tasks--response nil)
          (my/org-tasks-status "paused")
          (my/org-tasks-access-token "fake-tasks-token") (my/org-tasks-token-expiration (+ (float-time) 3600))
          (my/org-tasks-token-account my/org-tasks-account)
          (my/tasks-test-server (make-hash-table :test 'equal)) (my/tasks-test-counter 0)
          (my/tasks-test-calls nil) (my/tasks-test-offline nil) (my/tasks-test-drop-post nil)
          (my/tasks-test-race nil) (my/tasks-test-dirty-post nil) (my/tasks-test-page-size 100))
     (unwind-protect
         (progn
           (write-region "#+category: Personal\n* Inbox\n* Tasks\n* Notes\n" nil my/org-tasks--file nil 'silent)
           (write-region "#+category: Work\n* TODO Never upload Work\n" nil (my/org-file "work.org") nil 'silent)
           (my/org-tasks--load-state)
           (cl-letf (((symbol-function 'my/org-tasks--request) #'my/tasks-test-request)
                     ((symbol-function 'my/org-tasks--schedule) #'ignore)
                     ((symbol-function 'my/org-calendar-auto--refresh-agendas) #'ignore)
                     ((symbol-function 'my/org-calendar-view-refresh-visible) #'ignore))
             ,@body))
       (dolist (buffer (buffer-list))
         (when (with-current-buffer buffer (and buffer-file-name (string-prefix-p directory buffer-file-name)))
           (with-current-buffer buffer (set-buffer-modified-p nil)) (kill-buffer buffer)))
       (delete-directory directory t))))

(defun my/tasks-test-add (text)
  (with-current-buffer (my/org-tasks--buffer)
    (org-mode)
    (goto-char (point-min)) (search-forward "* Tasks") (org-end-of-subtree t t)
    (unless (bolp) (insert "\n"))
    (insert text) (let ((my/org-tasks--saving t)) (save-buffer))))

(defun my/tasks-test-record () (car (plist-get my/org-tasks--state :records)))
(defun my/tasks-test-task () (gethash (plist-get (my/tasks-test-record) :id) my/tasks-test-server))
(defun my/tasks-test-edit (function)
  (org-with-point-at (my/org-tasks--marker (plist-get (my/tasks-test-record) :key))
    (funcall function) (let ((my/org-tasks--saving t)) (save-buffer))))
(defun my/tasks-test-phone (id title &optional status day)
  (puthash id (list :id id :etag (format "phone-%d" (cl-incf my/tasks-test-counter))
                   :title title :status (or status "needsAction") :due (and day (concat day "T00:00:00Z")))
           my/tasks-test-server))
(defun my/tasks-test-choose (choice &optional candidate)
  (let ((record (my/tasks-test-record)))
    (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t)))
      (my/org-tasks-resolve (plist-get record :key) choice (plist-get record :local-version)
                           (if candidate (plist-get candidate :payload) (plist-get record :remote))
                           (if candidate (plist-get candidate :etag) (plist-get record :remote-etag))
                           (plist-get candidate :id)))))

(ert-deftest my/tasks-sync-imports-active-phone-tasks-but-leaves-historical-completions ()
  (my/tasks-test-workspace
    (my/tasks-test-phone "old" "Historical private completion" "completed")
    (my/tasks-test-phone "phone" "Phone task" "needsAction" "2026-10-14")
    (let ((my/tasks-test-page-size 1)) (my/org-tasks--start))
    (should (equal my/org-tasks-status "up to date"))
    (with-current-buffer (my/org-tasks--buffer)
      (should (string-match-p "\\*\\* TODO Phone task" (buffer-string)))
      (should (string-match-p "SCHEDULED: <2026-10-14" (buffer-string)))
      (should-not (string-match-p "Historical private completion" (buffer-string))))
    (should (member "old" (plist-get my/org-tasks--state :ignored)))
    (should-not (seq-some (lambda (call) (member (car call) '("POST" "PATCH" "DELETE"))) my/tasks-test-calls))
    (my/tasks-test-phone "new-completed" "New phone completion" "completed")
    (my/org-tasks--start)
    (with-current-buffer (my/org-tasks--buffer) (should (string-match-p "DONE New phone completion" (buffer-string))))))

(ert-deftest my/tasks-sync-publishes-all-personal-tasks-not-notes-work-or-planning-details ()
  (my/tasks-test-workspace
    (my/tasks-test-add "** TODO Org task\nSCHEDULED: <2026-10-14 Wed 10:00-11:00 +1w> DEADLINE: <2026-10-16 Fri>\nPrivate Org note\n** A note\nNo task state\n")
    (let ((work (with-temp-buffer (insert-file-contents (my/org-file "work.org")) (buffer-string))))
      (my/org-tasks--start)
      (should (= (hash-table-count my/tasks-test-server) 1))
      (should (equal (plist-get (my/tasks-test-task) :due) "2026-10-14T00:00:00.000Z"))
      (let ((post (seq-find (lambda (call) (equal (car call) "POST")) my/tasks-test-calls)))
        (should (equal (mapcar #'car (nth 2 post)) '(title status due))))
      (with-current-buffer (my/org-tasks--buffer)
        (should (string-match-p (regexp-quote "10:00-11:00 +1w") (buffer-string)))
        (should (string-match-p "DEADLINE: <2026-10-16" (buffer-string)))
        (should (string-match-p "Private Org note" (buffer-string))))
      (should (equal work (with-temp-buffer (insert-file-contents (my/org-file "work.org")) (buffer-string)))))))

