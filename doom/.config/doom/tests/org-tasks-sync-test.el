(defun my/tasks-test-kill-agendas ()
  (dolist (buffer (buffer-list))
    (when (with-current-buffer buffer (derived-mode-p 'org-agenda-mode)) (kill-buffer buffer))))

(ert-deftest my/tasks-sync-closes-the-buffer-it-opened-and-keeps-others ()
  (my/tasks-test-workspace
    (my/tasks-test-kill-agendas)
    (my/org-tasks--start)
    (should (equal my/org-tasks-status "up to date"))
    (should-not (get-file-buffer my/org-tasks--file))
    (let ((buffer (find-file-noselect my/org-tasks--file)))
      (my/org-tasks--start)
      (should (eq buffer (get-file-buffer my/org-tasks--file)))
      (kill-buffer buffer))
    (my/org-tasks--start)
    (let ((buffer (get-file-buffer my/org-tasks--file)))
      (should-not buffer)
      (setq buffer (my/org-tasks--buffer))
      (set-window-buffer (selected-window) buffer)
      (my/org-tasks--start)
      (should (eq buffer (get-file-buffer my/org-tasks--file))))))

(ert-deftest my/tasks-sync-keeps-an-opened-buffer-with-unsaved-edits-or-an-agenda ()
  (my/tasks-test-workspace
    (my/tasks-test-kill-agendas)
    (my/org-tasks--start)
    (with-current-buffer (my/org-tasks--buffer) (goto-char (point-max)) (insert "Unsaved\n"))
    (my/org-tasks--finish "up to date")
    (should (buffer-modified-p (get-file-buffer my/org-tasks--file)))
    (with-current-buffer (get-file-buffer my/org-tasks--file) (set-buffer-modified-p nil))
    (with-temp-buffer
      (org-agenda-mode)
      (my/org-tasks--finish "up to date")
      (should (get-file-buffer my/org-tasks--file)))
    (my/org-tasks--finish "up to date")
    (should-not (get-file-buffer my/org-tasks--file))))
