(ert-deftest my/tasks-sync-background-auth-does-not-open-browser-or-prompt ()
  (my/tasks-test-workspace
    (let ((my/org-tasks-access-token nil) (my/org-tasks-auth-problem nil)
          (my/org-calendar-login-process nil) (my/org-calendar-token-passphrase (copy-sequence "fake-unlock"))
          command process)
      (cl-letf (((symbol-function 'make-process)
                 (lambda (&rest args) (setq command (plist-get args :command)
                                           process (make-pipe-process :name "fake-task-refresh" :buffer nil :noquery t)) process))
                ((symbol-function 'process-send-string) #'ignore)
                ((symbol-function 'read-passwd) (lambda (&rest _) (ert-fail "Background must not prompt")))
                ((symbol-function 'my/org-tasks-access-show) (lambda () (ert-fail "Background must not pop up setup"))))
        (unwind-protect
            (progn (my/org-tasks--start)
                   (should (member "tasks-refresh-only" command))
                   (should (process-get process 'background))
                   (should-not my/tasks-test-calls))
          (when-let* ((timer (and process (process-get process 'timeout-timer)))) (cancel-timer timer))
          (when process (delete-process process)))))))

