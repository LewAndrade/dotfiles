            ((symbol-function 'my/agent-shell-repository-candidates) (lambda () '("/repo/")))
            ((symbol-function 'projectile-project-root) (lambda () "/repo/"))
            ((symbol-function 'completing-read) (lambda (&rest _) "/repo/"))
            ((symbol-function 'file-directory-p) (lambda (directory) (equal directory "/repo/"))))
    (should (equal (my/agent-shell-read-repository) "/repo/"))))

(ert-deftest my/agent-repository-candidates-include-worktrees-and-deduplicate ()
  (let* ((dev (expand-file-name "~/Dev/"))
         (repository (concat dev "repo"))
         (worktree (concat dev "worktree"))
         (outside "/outside/repo")
         (projectile-known-projects (list repository outside "/missing")))
    (cl-letf (((symbol-function 'directory-files)
               (lambda (&rest _) (list repository worktree (concat dev "notes"))))
              ((symbol-function 'file-directory-p)
               (lambda (directory) (not (equal directory "/missing"))))
              ((symbol-function 'file-exists-p)
               (lambda (file) (member file (mapcar (lambda (dir) (concat dir "/.git"))
                                                   (list repository worktree outside)))))
              ((symbol-function 'file-equal-p) #'equal))
      (should (equal (my/agent-shell-repository-candidates)
                     (sort (mapcar (lambda (dir) (abbreviate-file-name (concat dir "/")))
                                   (list repository worktree outside)) #'string-lessp))))))
