(ert-deftest my/agent-repository-commands-use-selected-directory-and-agent ()
  (let ((origin default-directory)
         (chosen (expand-file-name "~/Dev/balance/"))
         calls buffers)
    (unwind-protect
        (cl-letf (((symbol-function 'require) (lambda (&rest _) t))
                  ((symbol-function 'agent-shell-anthropic-start-claude-code)
                   (lambda ()
                     (push (list 'claude default-directory) calls)
                     (car (push (generate-new-buffer " *claude-picker-test*") buffers))))
                  ((symbol-function 'agent-shell-opencode-start-agent)
                   (lambda ()
                     (push (list 'opencode default-directory) calls)
                     (car (push (generate-new-buffer " *opencode-picker-test*") buffers)))))
          (my/agent-shell-claude-repository chosen)
          (my/agent-shell-opencode-repository chosen)
          (should (equal calls `((opencode ,chosen) (claude ,chosen))))
          (should (equal default-directory origin))
          (dolist (buffer buffers)
            (with-current-buffer buffer
              (should (local-variable-p 'agent-shell-cwd-function))
              (should (equal (funcall agent-shell-cwd-function) chosen)))))
      (mapc #'kill-buffer buffers))))

(ert-deftest my/agent-directory-start-overrides-project-root-detection ()
  (dolist (directory '("/repo/nested/" "/var/folders/temp-session/"))
    (let ((origin default-directory)
          (agent-shell-cwd-function (lambda () "/unrelated-project/"))
          buffer)
      (unwind-protect
          (progn
            (setq buffer
                  (my/agent-shell-start-in-directory
                   directory
                   (lambda ()
                     (should (equal (funcall agent-shell-cwd-function) directory))
                     (generate-new-buffer " *directory-picker-test*"))))
            (with-current-buffer buffer
              (should (equal default-directory directory))
              (should (equal (funcall agent-shell-cwd-function) directory)))
            (should (equal default-directory origin))
            (should (equal (funcall agent-shell-cwd-function) "/unrelated-project/")))
        (when buffer (kill-buffer buffer))))))

