(ert-deftest my/opencode-dev-list-preserves-cursors-and-input ()
  (let* ((state '((:agent-config . ((:identifier . opencode)))))
         (request `((:method . "session/list")
                    (:params . ((cwd . ,(expand-file-name "~/Dev"))
                                (cursor . "page-2")))))
         (response `((sessions . [((sessionId . "bacc-682")
                                   (cwd . ,(expand-file-name "~/Dev/balance-interest-bacc-682")))
                                  ((sessionId . "other") (cwd . "/elsewhere"))])
                     (nextCursor . "page-3")))
         sent received)
    (my/agent-shell--dev-list-request
     (lambda (&rest args)
       (setq sent (plist-get args :request))
       (funcall (plist-get args :on-success) response))
     :state state :request request :on-success (lambda (value) (setq received value)))
    (should-not (map-nested-elt sent '(:params cwd)))
    (should (equal (map-nested-elt sent '(:params cursor)) "page-2"))
    (should (equal (map-nested-elt request '(:params cwd)) (expand-file-name "~/Dev")))
    (should (= (length (map-elt response 'sessions)) 2))
    (should (equal (map-elt received 'nextCursor) "page-3"))
    (should (equal (map-elt (aref (map-elt received 'sessions) 0) 'sessionId) "bacc-682"))))

(ert-deftest my/opencode-dev-empty-page-keeps-next-cursor ()
  (let (received)
    (my/agent-shell--dev-list-request
     (lambda (&rest args)
       (should (hash-table-p (map-elt (plist-get args :request) :params)))
       (funcall (plist-get args :on-success)
                '((sessions . [((cwd . "/elsewhere"))]) (nextCursor . "older"))))
     :state '((:agent-config . ((:identifier . opencode))))
     :request `((:method . "session/list") (:params . ((cwd . ,(expand-file-name "~/Dev")))))
     :on-success (lambda (value) (setq received value)))
    (should (seq-empty-p (map-elt received 'sessions)))
    (should (equal (map-elt received 'nextCursor) "older"))))

(ert-deftest my/opencode-dev-other-agents-and-directories-unchanged ()
  (dolist (case `((other-agent ,(expand-file-name "~/Dev") "session/list")
                 (opencode ,(expand-file-name "~/Dev/balance-interest") "session/list")
                 (claude-code ,(expand-file-name "~/Dev/balance-interest") "session/list")
                 (claude-code ,(expand-file-name "~/Dev") "session/load")
                 (opencode ,(expand-file-name "~/Dev") "session/load")))
    (let* ((request `((:method . ,(nth 2 case)) (:params . ((cwd . ,(nth 1 case))))))
           (callback #'ignore)
           (failure #'ignore))
      (my/agent-shell--dev-list-request
       (lambda (&rest args)
         (should (eq (plist-get args :request) request))
         (should (eq (plist-get args :on-success) callback))
         (should (eq (plist-get args :on-failure) failure)))
       :state `((:agent-config . ((:identifier . ,(car case)))))
       :request request :on-success callback :on-failure failure))))

