    (let ((default-directory (expand-file-name "~/Dev/"))
          (worktree (expand-file-name "~/Dev/balance-interest-bacc-669/")))
      (cl-letf (((symbol-function 'agent-shell--state)
                 (lambda () '((:agent-config . ((:identifier . opencode))))))
                ((symbol-function 'agent-shell-cwd) (lambda () default-directory)))
        (let ((choice `((sessionId . "bacc-669") (cwd . ,(directory-file-name worktree)))))
          (should (eq (my/agent-shell--dev-select-session (lambda (&rest _) choice)) choice))
