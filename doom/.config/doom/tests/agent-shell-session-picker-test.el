;;; agent-shell-session-picker-test.el -*- lexical-binding: t; -*-
;; Run from the dotfiles/doom/.config/doom directory:
;; emacs -Q --batch -l tests/agent-shell-session-picker-test.el -f ert-run-tests-batch-and-exit
(require 'ert)
(require 'cl-lib)
(require 'map)
(require 'seq)
(require 'subr-x)

;; Filesystem mocks must not affect Emacs while it compiles mock trampolines.
(setq native-comp-enable-subr-trampolines nil)

;; Load only the integration helpers, without starting Doom or any agents.
(with-temp-buffer
  (insert-file-contents
   (expand-file-name "../config.org" (file-name-directory load-file-name)))
  (goto-char (point-min))
  (while (re-search-forward
          "^(defun my/agent-shell-\\(?:-dev-\\|-directory-in-dev-p\\|start-in-directory\\|.*repository\\)" nil t)
    (goto-char (match-beginning 0))
    (eval (read (current-buffer)) t)))

(defvar agent-shell-cwd-function nil)
(defvar projectile-known-projects nil)

(ert-deftest my/opencode-dev-directory-boundary ()
  (dolist (directory (list "~/Dev" "~/Dev/" "~/Dev/balance-interest-bacc-682"))
    (should (my/agent-shell--directory-in-dev-p directory)))
  (dolist (directory (list nil "~/Dev-old" "~/Developer" "~/.cache/agent-shell-labels"))
    (should-not (my/agent-shell--directory-in-dev-p directory)))
  (when (file-name-case-insensitive-p (expand-file-name "~/Dev/"))
    (should (my/agent-shell--directory-in-dev-p "~/dev/balance"))))

(ert-deftest my/opencode-dev-list-preserves-cursors-and-input ()
  (let* ((state '((:agent-config . ((:identifier . opencode)))))
         (request `((:method . "session/list")
                    (:params . ((cwd . ,(expand-file-name "~/Dev"))
                                (cursor . "page-2")))))
         (response `((sessions . [((sessionId . "bacc-682")
                                   (cwd . ,(expand-file-name "~/Dev/balance-interest-bacc-682")))
                                  ((sessionId . "other") (cwd . "/elsewhere"))])
                     (nextCursor . "page-3")))
         sent received)
    (my/agent-shell--dev-list-request
     (lambda (&rest args)
       (setq sent (plist-get args :request))
       (funcall (plist-get args :on-success) response))
     :state state :request request :on-success (lambda (value) (setq received value)))
    (should-not (map-nested-elt sent '(:params cwd)))
    (should (equal (map-nested-elt sent '(:params cursor)) "page-2"))
    (should (equal (map-nested-elt request '(:params cwd)) (expand-file-name "~/Dev")))
    (should (= (length (map-elt response 'sessions)) 2))
    (should (equal (map-elt received 'nextCursor) "page-3"))
    (should (equal (map-elt (aref (map-elt received 'sessions) 0) 'sessionId) "bacc-682"))))

(ert-deftest my/opencode-dev-empty-page-keeps-next-cursor ()
  (let (received)
    (my/agent-shell--dev-list-request
     (lambda (&rest args)
       (should (hash-table-p (map-elt (plist-get args :request) :params)))
       (funcall (plist-get args :on-success)
                '((sessions . [((cwd . "/elsewhere"))]) (nextCursor . "older"))))
     :state '((:agent-config . ((:identifier . opencode))))
     :request `((:method . "session/list") (:params . ((cwd . ,(expand-file-name "~/Dev")))))
     :on-success (lambda (value) (setq received value)))
    (should (seq-empty-p (map-elt received 'sessions)))
    (should (equal (map-elt received 'nextCursor) "older"))))

(ert-deftest my/opencode-dev-other-agents-and-directories-unchanged ()
  (dolist (case `((other-agent ,(expand-file-name "~/Dev") "session/list")
                 (opencode ,(expand-file-name "~/Dev/balance-interest") "session/list")
                 (claude-code ,(expand-file-name "~/Dev/balance-interest") "session/list")
                 (claude-code ,(expand-file-name "~/Dev") "session/load")
                 (opencode ,(expand-file-name "~/Dev") "session/load")))
    (let* ((request `((:method . ,(nth 2 case)) (:params . ((cwd . ,(nth 1 case))))))
           (callback #'ignore)
           (failure #'ignore))
      (my/agent-shell--dev-list-request
       (lambda (&rest args)
         (should (eq (plist-get args :request) request))
         (should (eq (plist-get args :on-success) callback))
         (should (eq (plist-get args :on-failure) failure)))
       :state `((:agent-config . ((:identifier . ,(car case)))))
       :request request :on-success callback :on-failure failure))))

(ert-deftest my/opencode-dev-selection-preserves-worktree-directory ()
  (with-temp-buffer
    (let ((default-directory (expand-file-name "~/Dev/"))
          (worktree (expand-file-name "~/Dev/balance-interest-bacc-669/")))
      (cl-letf (((symbol-function 'agent-shell--state)
                 (lambda () '((:agent-config . ((:identifier . opencode))))))
                ((symbol-function 'agent-shell-cwd) (lambda () default-directory)))
        (let ((choice `((sessionId . "bacc-669") (cwd . ,(directory-file-name worktree)))))
          (should (eq (my/agent-shell--dev-select-session (lambda (&rest _) choice)) choice))
          (should (equal default-directory worktree))
          (should (local-variable-p 'agent-shell-cwd-function))
          (should (equal (funcall agent-shell-cwd-function) worktree)))))))

(ert-deftest my/opencode-dev-new-and-other-shell-keep-dev-directory ()
  (dolist (choice '(nil :other-shell))
    (with-temp-buffer
      (let ((default-directory (expand-file-name "~/Dev/")))
        (cl-letf (((symbol-function 'agent-shell--state)
                   (lambda () '((:agent-config . ((:identifier . opencode))))))
                  ((symbol-function 'agent-shell-cwd) (lambda () default-directory)))
          (should (eq (my/agent-shell--dev-select-session (lambda (&rest _) choice)) choice))
          (should (equal default-directory (expand-file-name "~/Dev/")))
          (should-not (local-variable-p 'agent-shell-cwd-function)))))))

(ert-deftest my/claude-dev-list-includes-subrepositories ()
  (let (received)
    (my/agent-shell--dev-list-request
     (lambda (&rest args)
       (should (hash-table-p (map-elt (plist-get args :request) :params)))
       (funcall (plist-get args :on-success)
                `((sessions . [((sessionId . "dev") (cwd . ,(expand-file-name "~/Dev")))
                               ((sessionId . "repo") (cwd . ,(expand-file-name "~/Dev/balance")))
                               ((sessionId . "outside") (cwd . ,(expand-file-name "~/Dev-old")))])
                  (nextCursor . "next"))))
     :state '((:agent-config . ((:identifier . claude-code))))
     :request `((:method . "session/list") (:params . ((cwd . ,(expand-file-name "~/Dev")))))
     :on-success (lambda (value) (setq received value)))
    (should (equal (mapcar (lambda (s) (map-elt s 'sessionId))
                          (append (map-elt received 'sessions) nil)) '("dev" "repo")))
    (should (equal (map-elt received 'nextCursor) "next"))))

(ert-deftest my/claude-dev-selection-preserves-repository-directory ()
  (with-temp-buffer
    (let ((default-directory (expand-file-name "~/Dev/")))
      (cl-letf (((symbol-function 'agent-shell--state)
                 (lambda () '((:agent-config . ((:identifier . claude-code))))))
                ((symbol-function 'agent-shell-cwd) (lambda () default-directory)))
        (let ((choice `((cwd . ,(expand-file-name "~/Dev/balance")))))
          (my/agent-shell--dev-select-session (lambda (&rest _) choice))
          (should (equal default-directory (expand-file-name "~/Dev/balance/")))
          (should (equal (funcall agent-shell-cwd-function) default-directory)))))))

(ert-deftest my/agent-repository-commands-use-selected-directory-and-agent ()
  (let ((origin default-directory)
         (chosen (expand-file-name "~/Dev/balance/"))
         calls buffers)
    (unwind-protect
        (cl-letf (((symbol-function 'require) (lambda (&rest _) t))
                  ((symbol-function 'agent-shell-anthropic-start-claude-code)
                   (lambda ()
                     (push (list 'claude default-directory) calls)
                     (car (push (generate-new-buffer " *claude-picker-test*") buffers))))
                  ((symbol-function 'agent-shell-opencode-start-agent)
                   (lambda ()
                     (push (list 'opencode default-directory) calls)
                     (car (push (generate-new-buffer " *opencode-picker-test*") buffers)))))
          (my/agent-shell-claude-repository chosen)
          (my/agent-shell-opencode-repository chosen)
          (should (equal calls `((opencode ,chosen) (claude ,chosen))))
          (should (equal default-directory origin))
          (dolist (buffer buffers)
            (with-current-buffer buffer
              (should (local-variable-p 'agent-shell-cwd-function))
              (should (equal (funcall agent-shell-cwd-function) chosen)))))
      (mapc #'kill-buffer buffers))))

(ert-deftest my/agent-directory-start-overrides-project-root-detection ()
  (dolist (directory '("/repo/nested/" "/var/folders/temp-session/"))
    (let ((origin default-directory)
          (agent-shell-cwd-function (lambda () "/unrelated-project/"))
          buffer)
      (unwind-protect
          (progn
            (setq buffer
                  (my/agent-shell-start-in-directory
                   directory
                   (lambda ()
                     (should (equal (funcall agent-shell-cwd-function) directory))
                     (generate-new-buffer " *directory-picker-test*"))))
            (with-current-buffer buffer
              (should (equal default-directory directory))
              (should (equal (funcall agent-shell-cwd-function) directory)))
            (should (equal default-directory origin))
            (should (equal (funcall agent-shell-cwd-function) "/unrelated-project/")))
        (when buffer (kill-buffer buffer))))))

(ert-deftest my/agent-repository-picker-keeps-selected-subdirectory ()
  (cl-letf (((symbol-function 'require) (lambda (&rest _) t))
            ((symbol-function 'my/agent-shell-repository-candidates) (lambda () '("~/Dev/balance/")))
            ((symbol-function 'projectile-project-root) (lambda () nil))
            ((symbol-function 'completing-read)
             (lambda (_prompt choices &rest _)
               (should (member "Browse..." choices)) "Browse..."))
            ((symbol-function 'read-directory-name) (lambda (&rest _) "/repo/nested/"))
            ((symbol-function 'file-directory-p)
             (lambda (directory) (equal directory "/repo/nested/"))))
    (should (equal (my/agent-shell-read-repository) "/repo/nested/"))))

