(ert-deftest my/claude-dev-list-includes-subrepositories ()
  (let (received)
    (my/agent-shell--dev-list-request
     (lambda (&rest args)
       (should (hash-table-p (map-elt (plist-get args :request) :params)))
       (funcall (plist-get args :on-success)
                `((sessions . [((sessionId . "dev") (cwd . ,(expand-file-name "~/Dev")))
                               ((sessionId . "repo") (cwd . ,(expand-file-name "~/Dev/balance")))
                               ((sessionId . "outside") (cwd . ,(expand-file-name "~/Dev-old")))])
                  (nextCursor . "next"))))
     :state '((:agent-config . ((:identifier . claude-code))))
     :request `((:method . "session/list") (:params . ((cwd . ,(expand-file-name "~/Dev")))))
     :on-success (lambda (value) (setq received value)))
    (should (equal (mapcar (lambda (s) (map-elt s 'sessionId))
                          (append (map-elt received 'sessions) nil)) '("dev" "repo")))
    (should (equal (map-elt received 'nextCursor) "next"))))

